<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:StarXelem.ViewModels"
             xmlns:models="using:StarXelem.Models"
             xmlns:local="clr-namespace:StarXelem"
             xmlns:comp="clr-namespace:StarXelem.Components"
             xmlns:ui="clr-namespace:FluentAvalonia.UI.Controls;assembly=FluentAvalonia"
             mc:Ignorable="d" d:DesignWidth="1300" d:DesignHeight="800"
             d:DataContext="{x:Static local:DesignData.ReputationTabViewModel}"
             x:Class="StarXelem.Views.ReputationTabView"
             x:DataType="vm:ReputationTabViewModel">
    <UserControl.Styles>
        <!-- En-tête de portée cliquable : déplie la liste des rangs -->
        <Style Selector="Button.scope">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <ControlTemplate TargetType="Button">
                    <Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                        <ContentPresenter Content="{TemplateBinding Content}"
                                          ContentTemplate="{TemplateBinding ContentTemplate}"
                                          HorizontalContentAlignment="Stretch" />
                    </Border>
                </ControlTemplate>
            </Setter>
        </Style>
        <Style Selector="Button.scope Path.chevron">
            <Setter Property="Width" Value="9" />
            <Setter Property="Height" Value="9" />
            <Setter Property="Stretch" Value="Uniform" />
            <Setter Property="Stroke" Value="{DynamicResource Sx.MutedBrush}" />
            <Setter Property="StrokeThickness" Value="2" />
            <Setter Property="StrokeLineCap" Value="Round" />
            <Setter Property="StrokeJoin" Value="Round" />
            <Setter Property="Data" Value="M9 6l6 6-6 6" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style Selector="Button.scope:pointerover Path.chevron">
            <Setter Property="Stroke" Value="{DynamicResource Sx.TextBrush}" />
        </Style>
        <Style Selector="Button.scope Path.chevron.expanded">
            <Setter Property="RenderTransform" Value="rotate(90deg)" />
        </Style>

        <!-- Liste des rangs d'une portée -->
        <Style Selector="Border.standing-row">
            <Setter Property="Padding" Value="8,5" />
        </Style>
        <Style Selector="Border.standing-row TextBlock">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Foreground" Value="{DynamicResource Sx.SecondaryBrush}" />
        </Style>
        <Style Selector="Border.standing-row.current">
            <Setter Property="Background" Value="{DynamicResource Sx.AccentSoftBrush}" />
        </Style>
        <Style Selector="Border.standing-row.current TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource Sx.TextBrush}" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style Selector="Border.standing-row.locked TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource Sx.MutedBrush}" />
        </Style>
    </UserControl.Styles>

    <!-- La nouvelle charte n'existe qu'en thème sombre : l'écran reste sombre même si Windows est en thème clair. -->
    <ThemeVariantScope RequestedThemeVariant="Dark">
        <Grid Background="{DynamicResource Sx.BackgroundBrush}" TextElement.FontFamily="{DynamicResource Sx.FontSans}">

            <!-- Bloc principal -->
            <comp:NotchedBorder Margin="12" CutSize="18" Background="{DynamicResource Sx.SurfaceBrush}">
                <Grid RowDefinitions="Auto,Auto,*">

                    <!-- Barre d'outils -->
                    <Border Grid.Row="0" BorderBrush="{DynamicResource Sx.LineBrush}" BorderThickness="0,0,0,1" Padding="20,14">
                        <Grid ColumnDefinitions="Auto,Auto,*,Auto" ColumnSpacing="12">
                            <TextBlock Classes="sx-title" Text="Réputations" Margin="0,0,8,0" />
                            <TextBlock Grid.Column="1" Classes="sx-caption" FontSize="13" Text="{Binding ResultSummary}" />

                            <comp:NotchedBorder Grid.Column="2" Classes="sx-field" MinWidth="180">
                                <Grid ColumnDefinitions="Auto,*">
                                    <Path Classes="sx-search-icon" Margin="12,0,0,0" />
                                    <TextBox Grid.Column="1"
                                             Classes="sx"
                                             Height="44"
                                             Watermark="Rechercher un contractant ou une activité..."
                                             Text="{Binding SearchText}" />
                                </Grid>
                            </comp:NotchedBorder>

                            <Button Grid.Column="3" Classes="sx primary" Command="{Binding LoadDataCommand}">Charger les données</Button>
                        </Grid>
                    </Border>

                    <!-- Filtres rapides -->
                    <Border Grid.Row="1"
                            BorderBrush="{DynamicResource Sx.LineBrush}"
                            BorderThickness="0,0,0,1"
                            Padding="20,12,20,6">
                        <Grid ColumnDefinitions="72,*">
                            <TextBlock Classes="sx-caption" Text="État" VerticalAlignment="Top" Margin="0,9,0,0" />
                            <ItemsControl Grid.Column="1" ItemsSource="{Binding StatusChips}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:FilterChipViewModel">
                                        <Button Classes="sx-chip" Classes.on="{Binding IsSelected}" Command="{Binding ToggleCommand}">
                                            <StackPanel Orientation="Horizontal" Spacing="7">
                                                <TextBlock Text="{Binding Label}" VerticalAlignment="Center" />
                                                <TextBlock Classes="sx-count" Text="{Binding Count}" />
                                            </StackPanel>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Grid>
                    </Border>

                    <!-- Cartes des contractants -->
                    <Grid Grid.Row="2">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <ItemsControl ItemsSource="{Binding FilteredContractors}" Margin="20,16,8,10">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel Orientation="Horizontal" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>

                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="models:ContractorModel">
                                        <comp:NotchedBorder Width="300"
                                                            Margin="0,0,12,12"
                                                            CutSize="18"
                                                            Padding="18,16"
                                                            VerticalAlignment="Top"
                                                            Opacity="{Binding CardOpacity}"
                                                            Background="{DynamicResource Sx.ReliefBrush}">
                                            <StackPanel Spacing="12">
                                                <!-- En-tête : nom et relation -->
                                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                                    <TextBlock FontSize="16"
                                                               FontWeight="SemiBold"
                                                               Foreground="{DynamicResource Sx.TextBrush}"
                                                               TextWrapping="Wrap"
                                                               Text="{Binding Name}" />
                                                    <comp:NotchedBorder Grid.Column="1"
                                                                        Classes="sx-badge"
                                                                        Classes.success="{Binding IsFriendly}"
                                                                        Classes.danger="{Binding IsHostile}"
                                                                        VerticalAlignment="Top">
                                                        <StackPanel Orientation="Horizontal" Spacing="7">
                                                            <Ellipse />
                                                            <TextBlock Text="{Binding FactionStatusLabel}" />
                                                        </StackPanel>
                                                    </comp:NotchedBorder>
                                                </Grid>

                                                <!-- Portées de réputation -->
                                                <ItemsControl ItemsSource="{Binding Reputations}">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate x:DataType="models:ReputationModel">
                                                            <StackPanel Margin="0,0,0,10">
                                                                <Button Classes="scope"
                                                                        Command="{Binding ToggleExpandedCommand}"
                                                                        IsEnabled="{Binding HasStandings}"
                                                                        ToolTip.Tip="Afficher les rangs">
                                                                    <StackPanel>
                                                                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="6">
                                                                            <Path Classes="chevron" Classes.expanded="{Binding IsExpanded}" IsVisible="{Binding HasStandings}" />
                                                                            <TextBlock Grid.Column="1"
                                                                                       FontSize="12"
                                                                                       Foreground="{DynamicResource Sx.SecondaryBrush}"
                                                                                       TextTrimming="CharacterEllipsis"
                                                                                       Text="{Binding DisplayName}" />
                                                                            <TextBlock Grid.Column="2"
                                                                                       Classes="sx-mono"
                                                                                       FontSize="12"
                                                                                       Foreground="{DynamicResource Sx.TextBrush}"
                                                                                       Text="{Binding ValueDisplay}" />
                                                                        </Grid>
                                                                        <ProgressBar Classes="sx-quality"
                                                                                     Margin="0,5"
                                                                                     Minimum="{Binding ProgressMinimum}"
                                                                                     Maximum="{Binding ProgressMaximum}"
                                                                                     Value="{Binding ProgressValue}" />
                                                                        <TextBlock FontSize="12"
                                                                                   Foreground="{DynamicResource Sx.TextBrush}"
                                                                                   Text="{Binding CurrentStandingName}" />
                                                                    </StackPanel>
                                                                </Button>

                                                                <!-- Rangs de la portée -->
                                                                <Border IsVisible="{Binding IsExpanded}"
                                                                        Margin="0,8,0,0"
                                                                        Padding="0,8,0,0"
                                                                        BorderBrush="{DynamicResource Sx.LineBrush}"
                                                                        BorderThickness="0,1,0,0">
                                                                    <ItemsControl ItemsSource="{Binding StandingRows}">
                                                                        <ItemsControl.ItemTemplate>
                                                                            <DataTemplate x:DataType="models:StandingRowModel">
                                                                                <Border Classes="standing-row"
                                                                                        Classes.current="{Binding IsCurrent}"
                                                                                        Classes.locked="{Binding IsLocked}">
                                                                                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                                                                        <TextBlock TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Name}" Text="{Binding Name}" />
                                                                                        <TextBlock Grid.Column="1" FontFamily="{DynamicResource Sx.FontMono}" Text="{Binding Threshold}" />
                                                                                    </Grid>
                                                                                </Border>
                                                                            </DataTemplate>
                                                                        </ItemsControl.ItemTemplate>
                                                                    </ItemsControl>
                                                                </Border>
                                                            </StackPanel>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </StackPanel>
                                        </comp:NotchedBorder>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>

                        <TextBlock Classes="sx-caption"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   IsVisible="{Binding ShowNoMatch}"
                                   Text="Aucun contractant ne correspond à ces filtres." />

                        <!-- Indicateur de chargement / filtrage, superposé aux cartes -->
                        <Grid IsVisible="{Binding IsBusy}" IsHitTestVisible="False">
                            <Border Background="{DynamicResource Sx.SurfaceBrush}" Opacity="0.75" />
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="10">
                                <ui:ProgressRing IsIndeterminate="True" Width="40" Height="40" HorizontalAlignment="Center" />
                                <TextBlock Classes="sx-caption" HorizontalAlignment="Center" Text="{Binding BusyMessage}" />
                            </StackPanel>
                        </Grid>
                    </Grid>
                </Grid>
            </comp:NotchedBorder>
        </Grid>
    </ThemeVariantScope>
</UserControl>
