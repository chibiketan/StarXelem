<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:StarXelem.ViewModels"
             x:Class="StarXelem.Views.ReputationTabView"
             x:DataType="vm:ReputationTabViewModel">

    <DockPanel LastChildFill="True">
        <!-- Toolbar Section -->
        <StackPanel DockPanel.Dock="Top"
                    Orientation="Horizontal"
                    Margin="16"
                    Spacing="12">

            <!-- Search Box (Design System Section 9) -->
            <TextBox Text="{Binding SearchText, Mode=TwoWay}"
                     Width="300"
                     Watermark="Rechercher un contracteur..."
                     VerticalAlignment="Center" />

            <!-- Load Button (Design System Section 8) -->
            <Button Command="{Binding LoadDataCommand}"
                    Padding="11,5"
                    CornerRadius="7"
                    VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <PathIcon Data="{StaticResource Icon.Refresh}"
                              Width="11" Height="11" />
                    <TextBlock Text="Charger les données"
                               FontSize="11"
                               FontWeight="500" />
                </StackPanel>
            </Button>
        </StackPanel>

        <!-- Main Content -->
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <ItemsControl ItemsSource="{Binding FilteredContractors}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel Orientation="Horizontal" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>

                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <!-- Contractor Card (Design System Section 15) -->
                        <Border Width="300"
                                Margin="10"
                                CornerRadius="8"
                                BorderThickness="0.5"
                                BorderBrush="{DynamicResource BorderBrush}"
                                Background="{DynamicResource SurfaceCardBrush}">

                            <StackPanel Padding="16" Spacing="12">
                                <!-- Header -->
                                <TextBlock Text="{Binding Name}"
                                           FontSize="13"
                                           FontWeight="500"
                                           HorizontalAlignment="Center"
                                           Margin="0,0,0,4"/>

                                <!-- Reputations List -->
                                <ItemsControl ItemsSource="{Binding Reputations}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel Margin="0,0,0,10">
                                                <DockPanel LastChildFill="False">
                                                    <TextBlock Text="{Binding Category}"
                                                               FontSize="12"
                                                               FontWeight="500"
                                                               DockPanel.Dock="Left" />
                                                    <TextBlock Text="{Binding TierName}"
                                                               FontSize="11"
                                                               Foreground="{DynamicResource TextSecondaryBrush}"
                                                               DockPanel.Dock="Right" />
                                                </DockPanel>

                                                <ProgressBar Value="{Binding CurrentValue}"
                                                             Maximum="{Binding MaxValue}"
                                                             Height="4"
                                                             Margin="0,4,0,0"
                                                             Foreground="{DynamicResource AccentBrush}"
                                                             Background="{DynamicResource SurfaceBrush}" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </DockPanel>
</UserControl>
