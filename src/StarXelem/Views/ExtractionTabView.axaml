<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:StarXelem.ViewModels"
             xmlns:ic="clr-namespace:FluentIcons.Avalonia.Fluent;assembly=FluentIcons.Avalonia.Fluent"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="580"
             x:Class="StarXelem.Views.ExtractionTabView"
             x:DataType="vm:ExtractionTabViewModel">

    <UserControl.Styles>
        <!-- Labels de section -->
        <Style Selector="TextBlock.section-label">
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Foreground" Value="{DynamicResource DimmingBrush}"/>
            <Setter Property="LetterSpacing" Value="0.8"/>
        </Style>

        <!-- Titre d'action card -->
        <Style Selector="TextBlock.action-title">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Foreground" Value="{DynamicResource ForegroundBrush}"/>
        </Style>

        <!-- Description d'action card -->
        <Style Selector="TextBlock.action-desc">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Foreground" Value="{DynamicResource DimmingBrush}"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="LineHeight" Value="17"/>
        </Style>

        <!-- Bouton purple (CSV) -->
        <Style Selector="Button.btn-csv">
            <Setter Property="Background" Value="{DynamicResource ButtonPrimaryBackgroundBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource ButtonPrimaryBorderBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource ButtonPrimaryForegroundBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="7"/>
            <Setter Property="Padding" Value="14,7"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="Medium"/>

            <Style Selector="^:pointerover /template/ ContentPresenter">
                <Setter Property="Background" Value="{DynamicResource ButtonPrimaryHoverBackgroundBrush}"/>
            </Style>
        </Style>

        <!-- Bouton teal (Langue) -->
        <Style Selector="Button.btn-lang">
            <Setter Property="Background" Value="{DynamicResource BadgeUsageBackgroundColor}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BadgeUsageBorderColor}"/>
            <Setter Property="Foreground" Value="{DynamicResource BadgeUsageForegroundColor}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="7"/>
            <Setter Property="Padding" Value="14,7"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="Medium"/>

            <Style Selector="^:pointerover /template/ ContentPresenter">
                <Setter Property="Background" Value="{DynamicResource ButtonLangHoverBackgroundBrush}"/>
            </Style>
        </Style>
    </UserControl.Styles>

    <Panel Classes="main">
        <ScrollViewer HorizontalScrollBarVisibility="Disabled" Classes="main">
            <StackPanel Margin="28,24" Spacing="14">

                <!-- En-tête de page -->
                <StackPanel Spacing="2">
                    <TextBlock Text="Extractions" FontSize="15" FontWeight="Medium"
                               Foreground="{DynamicResource ForegroundBrush}" />
                    <TextBlock Text="Outils de génération et d'export de données du jeu" FontSize="11"
                               Foreground="{DynamicResource DimmingBrush}" />
                </StackPanel>

                <Separator Classes="horizontal" Background="{DynamicResource CardBorderBrush}" />

                <!-- Section : Données brutes -->
                <TextBlock Classes="section-label" Text="DONNÉES BRUTES" />

                <!-- Carte : Export CSV -->
                <Border Background="{DynamicResource CardBackgroundBrush}"
                        BorderBrush="{DynamicResource CardBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="10"
                        Padding="18,16">
                    <Grid ColumnDefinitions="Auto,*,Auto">
                        <Border Grid.Column="0"
                                Width="38" Height="38"
                                CornerRadius="9"
                                Background="{DynamicResource ButtonPrimaryBackgroundBrush}"
                                BorderBrush="{DynamicResource ButtonPrimaryBorderBrush}"
                                BorderThickness="1"
                                VerticalAlignment="Center">
                            <ic:SymbolIcon Symbol="Document"
                                           Foreground="{DynamicResource ButtonPrimaryForegroundBrush}"
                                           FontSize="17"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center" />
                        </Border>

                        <StackPanel Grid.Column="1" Margin="16,0" Spacing="4" VerticalAlignment="Center">
                            <TextBlock Classes="action-title" Text="Export CSV des IDs CIG" />
                            <TextBlock Classes="action-desc"
                                       Text="Génère un fichier CSV contenant l'ensemble des IDs CIG et leur valeur CRC32." />
                        </StackPanel>

                        <Button Name="ExtractCsvButton" Grid.Column="2"
                                Classes="btn-csv"
                                Command="{Binding ExtractCigIdsCommand}"
                                VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <ic:SymbolIcon Symbol="ArrowDownload" FontSize="11" />
                                <TextBlock Text="Générer" />
                            </StackPanel>
                        </Button>
                    </Grid>
                </Border>

                <!-- Statut CSV -->
                <Border IsVisible="{Binding IsExtractingCsv}"
                        Background="{DynamicResource CardBackgroundBrush}"
                        BorderBrush="{DynamicResource CardBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="7"
                        Padding="12,8">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <ProgressBar IsIndeterminate="False" Minimum="0" Maximum="100"
                                     Value="{Binding CsvProgress}"
                                     Height="3" HorizontalAlignment="Stretch" VerticalAlignment="Center" />
                        <TextBlock FontSize="11" Foreground="{DynamicResource DimmingBrush}" VerticalAlignment="Center">
                            <Run Text="Génération du fichier " />
                            <Run Text="CSV" Foreground="{DynamicResource ForegroundBrush}" FontWeight="Medium" />
                            <Run Text="…" />
                        </TextBlock>
                    </StackPanel>
                </Border>

                <Separator Classes="horizontal" Background="{DynamicResource CardBorderBrush}" />

                <!-- Section : Fichiers du jeu -->
                <TextBlock Classes="section-label" Text="FICHIERS DU JEU" />

                <!-- Carte : Mise à jour fichier de langue -->
                <Border Background="{DynamicResource CardBackgroundBrush}"
                        BorderBrush="{DynamicResource CardBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="10"
                        Padding="18,16">
                    <Grid ColumnDefinitions="Auto,*,Auto">
                        <Border Grid.Column="0"
                                Width="38" Height="38"
                                CornerRadius="9"
                                Background="{DynamicResource BadgeUsageBackgroundColor}"
                                BorderBrush="{DynamicResource BadgeUsageBorderColor}"
                                BorderThickness="1"
                                VerticalAlignment="Center">
                            <ic:SymbolIcon Symbol="Globe"
                                           Foreground="{DynamicResource BadgeUsageForegroundColor}"
                                           FontSize="17"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center" />
                        </Border>

                        <StackPanel Grid.Column="1" Margin="16,0" Spacing="4" VerticalAlignment="Center">
                            <TextBlock Classes="action-title" Text="Mise à jour du fichier de langue" />
                            <TextBlock Classes="action-desc"
                                       Text="Extrait les libellés des fichiers du jeu, identifie les composants, ajoute le type, la taille et le rang, puis dépose le fichier au bon endroit pour être utilisé par le jeu." />
                        </StackPanel>

                        <Button Name="UpdateLangButton" Grid.Column="2"
                                Classes="btn-lang"
                                Command="{Binding UpdateLocalisationCommand}"
                                VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <ic:SymbolIcon Symbol="ArrowSync" FontSize="11" />
                                <TextBlock Text="Mettre à jour" />
                            </StackPanel>
                        </Button>
                    </Grid>
                </Border>

                <!-- Statut Langue -->
                <Border IsVisible="{Binding IsExtractingLang}"
                        Background="{DynamicResource CardBackgroundBrush}"
                        BorderBrush="{DynamicResource BadgeUsageBorderColor}"
                        BorderThickness="1"
                        CornerRadius="7"
                        Padding="12,8">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <ProgressBar IsIndeterminate="False" Minimum="0" Maximum="100"
                                     Value="{Binding LangProgress}"
                                     Height="3" HorizontalAlignment="Stretch" VerticalAlignment="Center"
                                     Foreground="{DynamicResource BadgeUsageForegroundColor}" />
                        <TextBlock Text="{Binding StatusMessage}"
                                   FontSize="11"
                                   Foreground="{DynamicResource DimmingBrush}"
                                   VerticalAlignment="Center" />
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer></Panel>
</UserControl>
