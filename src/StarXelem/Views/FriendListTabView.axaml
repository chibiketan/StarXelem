<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:ic="clr-namespace:FluentIcons.Avalonia.Fluent;assembly=FluentIcons.Avalonia.Fluent"
             xmlns:vm="clr-namespace:StarXelem.ViewModels"
             xmlns:local="clr-namespace:StarXelem"
             xmlns:asyncImageLoader="clr-namespace:AsyncImageLoader;assembly=AsyncImageLoader.Avalonia"
             xmlns:models="clr-namespace:StarXelem.Models"
             mc:Ignorable="d" d:DesignWidth="1000" d:DesignHeight="450"
             x:DataType="vm:FriendListTabViewModel"
             d:DataContext="{x:Static local:DesignData.FriendListTabViewModel}"
             x:Class="StarXelem.Views.FriendListTabView">
    <UserControl.Styles>
        <Style Selector=".main > Grid.header">
            <Setter Property="Margin" Value="15" />
        </Style>
        <Style Selector="DataGrid">
            <Style Selector="^ DataGridColumnHeader">
                <Setter Property="Padding" Value="15" />
                <Setter Property="FontSize" Value="{DynamicResource H2FontSize}" />
                <Setter Property="FontWeight" Value="DemiBold" />
                <Setter Property="Foreground" Value="{DynamicResource DimmingBrush}" />
                <Setter Property="AreSeparatorsVisible" Value="False" />
            </Style>

        </Style>
        <Style Selector="Ellipse.status-indicator">
            <Setter Property="Fill" Value="Gray" />
        </Style>
        <Style Selector="Ellipse.status-indicator.connected">
            <Setter Property="Fill" Value="#4CAF50" />
        </Style>    
        <Style Selector="DataGridCell.dimming TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource DimmingBrush}" />
        </Style>

        <!-- Activity badges -->
        <Style Selector="Border.badge.offline">
            <Setter Property="Background" Value="{DynamicResource BadgeTimerBackgroundColor}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BadgeTimerBorderColor}" />
        </Style>
        <Style Selector="Border.badge.offline Ellipse">
            <Setter Property="Fill" Value="{DynamicResource BadgeTimerForegroundColor}" />
        </Style>
        <Style Selector="Border.badge.offline TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource BadgeTimerForegroundColor}" />
        </Style>

        <Style Selector="Border.badge.persistentUniverse">
            <Setter Property="Background" Value="{DynamicResource BadgeTiers1BackgroundColor}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BadgeTiers1BorderColor}" />
        </Style>
        <Style Selector="Border.badge.persistentUniverse Ellipse">
            <Setter Property="Fill" Value="{DynamicResource BadgeTiers1ForegroundColor}" />
        </Style>
        <Style Selector="Border.badge.persistentUniverse TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource BadgeTiers1ForegroundColor}" />
        </Style>

        <Style Selector="Border.badge.menu">
            <Setter Property="Background" Value="{DynamicResource BadgeUsageBackgroundColor}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BadgeUsageBorderColor}" />
        </Style>
        <Style Selector="Border.badge.menu Ellipse">
            <Setter Property="Fill" Value="{DynamicResource BadgeUsageForegroundColor}" />
        </Style>
        <Style Selector="Border.badge.menu TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource BadgeUsageForegroundColor}" />
        </Style>

        <Style Selector="Border.badge.arenaCommander">
            <Setter Property="Background" Value="{DynamicResource BadgeArenaCommanderBackgroundColor}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BadgeArenaCommanderBorderColor}" />
        </Style>
        <Style Selector="Border.badge.arenaCommander Ellipse">
            <Setter Property="Fill" Value="{DynamicResource BadgeArenaCommanderForegroundColor}" />
        </Style>
        <Style Selector="Border.badge.arenaCommander TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource BadgeArenaCommanderForegroundColor}" />
        </Style>

        <!-- Badges région -->
        <Style Selector="Border.badge.regionEurope">
            <Setter Property="Background" Value="{DynamicResource BadgeRegionEuropeBackgroundColor}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BadgeRegionEuropeBorderColor}" />
            <Style Selector="^ TextBlock">
                <Setter Property="Foreground" Value="{DynamicResource BadgeRegionEuropeForegroundColor}" />
            </Style>
        </Style>
        <Style Selector="Border.badge.regionUsa">
            <Setter Property="Background" Value="{DynamicResource BadgeRegionUsaBackgroundColor}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BadgeRegionUsaBorderColor}" />
            <Style Selector="^ TextBlock">
                <Setter Property="Foreground" Value="{DynamicResource BadgeRegionUsaForegroundColor}" />
            </Style>
        </Style>
        <Style Selector="Border.badge.regionAsie">
            <Setter Property="Background" Value="{DynamicResource BadgeRegionAsieBackgroundColor}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BadgeRegionAsieBorderColor}" />
            <Style Selector="^ TextBlock">
                <Setter Property="Foreground" Value="{DynamicResource BadgeRegionAsieForegroundColor}" />
            </Style>
        </Style>
        <Style Selector="Border.badge.regionAustralie">
            <Setter Property="Background" Value="{DynamicResource BadgeRegionAustralieBackgroundColor}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BadgeRegionAustralieBorderColor}" />
            <Style Selector="^ TextBlock">
                <Setter Property="Foreground" Value="{DynamicResource BadgeRegionAustralieForegroundColor}" />
            </Style>
        </Style>

        <!-- Avatar -->
        <Style Selector="Image.avatar">
            <Setter Property="MaxWidth" Value="50" />
            <Setter Property="MaxHeight" Value="50" />
            <Setter Property="Margin" Value="10" />
        </Style>
        <Style Selector="Border.avatar-placeholder">
            <Setter Property="Width" Value="50" />
            <Setter Property="Height" Value="50" />
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Margin" Value="10" />
        </Style>
        <Style Selector="Border.avatar-placeholder TextBlock">
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="FontSize" Value="16" />
        </Style>
    </UserControl.Styles>
    <Grid RowDefinitions="Auto,*" Classes="main">
        <Grid Grid.Row="0" ColumnSpacing="15" Classes="header" ColumnDefinitions="Auto, Auto, *,Auto" Height="45">
            <Button Classes="btn principal" Command="{Binding LoadFriendListCommand}">
                <Grid ColumnDefinitions="Auto,*">
                    <ic:SymbolIcon Grid.Column="0" Symbol="ArrowSync">
                        <ic:SymbolIcon.RenderTransform>
                            <RotateTransform Angle="90"/>
                        </ic:SymbolIcon.RenderTransform>
                    </ic:SymbolIcon>
                    <Label Grid.Column="1">Actualiser</Label>
                </Grid>
            </Button>
            <Separator Grid.Column="1" Classes="vertical" />
            <ToggleSwitch Grid.Column="2" OffContent="Tous les amis" OnContent="Uniquement les amis connectés" IsChecked="{Binding OnlyConnected}" VerticalAlignment="Center"  VerticalContentAlignment="Center" />
            <Grid Grid.Column="3" ColumnDefinitions="Auto,Auto" VerticalAlignment="Center" Margin="0 0 15 0">
                <TextBlock Grid.Column="0" Text="{Binding FilteredFriendList.Count, FallbackValue=''}" />
                <TextBlock Grid.Column="1" Classes="dimming" Text="{Binding FriendList^.Count, StringFormat=' / {0} amis', FallbackValue=0 amis}" />
            </Grid>
        </Grid>
        <Grid Grid.Row="1">
            <DataGrid ItemsSource="{Binding FilteredFriendList}" AutoGenerateColumns="False" IsReadOnly="True" GridLinesVisibility="Horizontal" >
                <DataGrid.Resources>
                    <!-- Permet de ne plus réserver d'espace à droite pour l'icone de tri -->
                    <x:Double x:Key="DataGridSortIconMinWidth">0</x:Double>
                </DataGrid.Resources>
                <DataGrid.Styles>
                    <Style Selector="DataGridColumnHeader:nth-last-child(1)">
                        <Setter Property="HorizontalContentAlignment" Value="Right"></Setter>
                    </Style>
                </DataGrid.Styles>
                <DataGrid.Columns>
                    <DataGridTemplateColumn Header="">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate DataType="{x:Type models:FriendViewModel}">
                                <Panel HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <Image Classes="avatar"
                                           asyncImageLoader:ImageLoader.Source="{Binding AvatarUrl}"
                                           IsVisible="{Binding AvatarUrl, Converter={x:Static ObjectConverters.IsNotNull}}" />
                                    <Border Classes="badge persistentUniverse avatar-placeholder"
                                            IsVisible="{Binding AvatarUrl, Converter={x:Static ObjectConverters.IsNull}}">
                                        <TextBlock Text="{Binding Initials}" />
                                    </Border>
                                </Panel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTemplateColumn Header="PSEUDO">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate DataType="{x:Type models:FriendViewModel}">
                                <Grid ColumnDefinitions="Auto,*" Margin="15,0">
                                    <Ellipse Grid.Column="0" Classes="status-indicator" Classes.connected="{Binding IsConnected}" Width="8" Height="8" VerticalAlignment="Center" Margin="0,0,6,0" />
                                    <TextBlock Grid.Column="1" Text="{Binding DisplayName}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" Classes.dimming="{Binding IsConnected, Converter={x:Static BoolConverters.Not}}" />
                                </Grid>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Header="NOM DU COMPTE" Binding="{Binding TokenName}" CellStyleClasses="dimming" />
                    <DataGridTemplateColumn Header="STATUT">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate DataType="{x:Type models:FriendViewModel}">
                                <Border Classes="badge"
                                        Classes.offline="{Binding IsOffline}"
                                        Classes.persistentUniverse="{Binding IsInPersistentUniverse}"
                                        Classes.menu="{Binding IsInMenu}"
                                        Classes.arenaCommander="{Binding IsInArenaCommander}"
                                        HorizontalAlignment="Left" Margin="15,0">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <Ellipse Width="7" Height="7" VerticalAlignment="Center" />
                                        <TextBlock Text="{Binding ActivityLabel}" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Header="SHARD" Binding="{Binding ShardId^, FallbackValue=Chargement}" CellStyleClasses="dimming" />
                    <DataGridTemplateColumn Header="REGION">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate DataType="{x:Type models:FriendViewModel}">
                                <Border Classes="badge"
                                        Classes.regionEurope="{Binding IsEuropeRegion^}"
                                        Classes.regionUsa="{Binding IsUsaRegion^}"
                                        Classes.regionAsie="{Binding IsAsieRegion^}"
                                        Classes.regionAustralie="{Binding IsAustralieRegion^}"
                                        IsVisible="{Binding ShardRegion^, Converter={x:Static ObjectConverters.IsNotNull}}"
                                        HorizontalAlignment="Left" Margin="15,0">
                                    <TextBlock Text="{Binding ShardRegion^}" VerticalAlignment="Center" />
                                </Border>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTemplateColumn Header="JOUEUR" >
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate DataType="{x:Type models:FriendViewModel}">
                                <Grid ColumnDefinitions="30,10,30" IsVisible="{Binding ShardTotalPlayers^, Converter={x:Static ObjectConverters.IsNotNull}}" VerticalAlignment="Center" HorizontalAlignment="Right">
                                    <TextBlock Grid.Column="0" Text="{Binding ShardPlayerCount^}" HorizontalAlignment="Right" />
                                    <TextBlock Grid.Column="1" Classes="dimming" HorizontalAlignment="Center">/</TextBlock>
                                    <TextBlock Grid.Column="2" Classes="dimming" Text="{Binding ShardTotalPlayers^}" />
                                </Grid>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    
                </DataGrid.Columns>
            </DataGrid>
        </Grid>
    </Grid>
</UserControl>
