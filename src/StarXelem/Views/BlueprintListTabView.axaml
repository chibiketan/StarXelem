<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:ic="clr-namespace:FluentIcons.Avalonia.Fluent;assembly=FluentIcons.Avalonia.Fluent"
             xmlns:vm="clr-namespace:StarXelem.ViewModels"
             xmlns:local="clr-namespace:StarXelem"
             xmlns:conv="clr-namespace:StarXelem.Converters"
             xmlns:comp="clr-namespace:StarXelem.Comparer"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:DataType="vm:BlueprintListTabViewModel"
             d:DataContext="{x:Static local:DesignData.BlueprintListTabViewModel}"
             x:Class="StarXelem.Views.BlueprintListTabView">
    <UserControl.Resources>
        <ResourceDictionary>
            <conv:MicroScuConverter x:Key="MicroScuConverter" />
            <conv:TaskIsFinishedConverter x:Key="TaskIsFinishedConverter" />
            <conv:TaskIsNotFinishedConverter x:Key="TaskIsNotFinishedConverter" />
            <conv:MinusOneToInfinityConverter x:Key="MinusOneToInfinityConverter" />
            <comp:TaskStringComparer x:Key="TaskStringComparer" />
            <comp:ItemViewModelName x:Key="ItemViewModelName" />
            <comp:ItemViewModelOwnerComparer x:Key="ItemViewModelOwnerComparer" />
            <StreamGeometry x:Key="arrow_rotate_clockwise_regular">M12 3C16.9706 3 21 7.02944 21 12C21 15.0777 19.4407 17.865 16.9769 19.5009L18.75 19.5C19.1642 19.5 19.5 19.8358 19.5 20.25C19.5 20.6297 19.2178 20.9435 18.8518 20.9932L18.75 21H14.75C14.3703 21 14.0565 20.7178 14.0068 20.3518L14 20.25V16.25C14 15.8358 14.3358 15.5 14.75 15.5C15.1297 15.5 15.4435 15.7822 15.4932 16.1482L15.5 16.25L15.501 18.635C17.9241 17.3557 19.5 14.8247 19.5 12C19.5 7.85786 16.1421 4.5 12 4.5C7.85786 4.5 4.5 7.85786 4.5 12C4.5 12.4142 4.16421 12.75 3.75 12.75C3.33579 12.75 3 12.4142 3 12C3 7.02944 7.02944 3 12 3ZM12 9.25C13.5188 9.25 14.75 10.4812 14.75 12C14.75 13.5188 13.5188 14.75 12 14.75C10.4812 14.75 9.25 13.5188 9.25 12C9.25 10.4812 10.4812 9.25 12 9.25ZM12 10.75C11.3096 10.75 10.75 11.3096 10.75 12C10.75 12.6904 11.3096 13.25 12 13.25C12.6904 13.25 13.25 12.6904 13.25 12C13.25 11.3096 12.6904 10.75 12 10.75Z</StreamGeometry>
            <StreamGeometry x:Key="arrow_sync_circle_regular">M12,2 C17.5228,2 22,6.47715 22,12 C22,17.5228 17.5228,22 12,22 C6.47715,22 2,17.5228 2,12 C2,6.47715 6.47715,2 12,2 Z M12,3.5 C7.30558,3.5 3.5,7.30558 3.5,12 C3.5,16.6944 7.30558,20.5 12,20.5 C16.6944,20.5 20.5,16.6944 20.5,12 C20.5,7.30558 16.6944,3.5 12,3.5 Z M16.75,12 C17.1296833,12 17.4434889,12.2821653 17.4931531,12.6482323 L17.5,12.75 L17.5,15.75 C17.5,16.1642 17.1642,16.5 16.75,16.5 C16.3703167,16.5 16.0565111,16.2178347 16.0068469,15.8517677 L16,15.75 L16,15 C15.0881,16.2143 13.6362,17 11.9999,17 C10.4748,17 9.09587,16.316 8.17857,15.237 C7.91028,14.9214 7.94862,14.4481 8.2642,14.1798 C8.57979,13.9115 9.05311,13.9499 9.3214,14.2655 C9.96322,15.0204 10.9293,15.5 11.9999,15.5 C13.32553,15.5 14.4803167,14.7625672 15.0742404,13.6746351 L15.1633,13.5 L14,13.5 C13.5858,13.5 13.25,13.1642 13.25,12.75 C13.25,12.3703167 13.5321653,12.0565111 13.8982323,12.0068469 L14,12 L16.75,12 Z M11.9999,7 C13.5368,7 14.9041,7.66036 15.8268,8.77062 C16.0915,9.08918 16.0479,9.56205 15.7294,9.8268 C15.4108,10.0916 14.9379,10.0479 14.6732,9.72938 C14.0368,8.96361 13.093,8.5 11.9999,8.5 C10.5754318,8.5 9.34895806,9.35140335 8.80281957,10.5730172 L8.72948,10.75 L10,10.75 C10.4142,10.75 10.75,11.0858 10.75,11.5 C10.75,11.8796833 10.4678347,12.1934889 10.1017677,12.2431531 L10,12.25 L7.25,12.25 C6.8703075,12.25 6.55650958,11.9678347 6.50684668,11.6017677 L6.5,11.5 L6.5,8.25 C6.5,7.83579 6.83579,7.5 7.25,7.5 C7.6296925,7.5 7.94349042,7.78215688 7.99315332,8.14823019 L8,8.25 L8,8.99955 C8.9121,7.78531 10.364,7 11.9999,7 Z</StreamGeometry>
            <StreamGeometry x:Key="remove_regular">M3.7547787,12.4995322 L20.2466903,12.4995322 C20.6609039,12.4995322 20.9966903,12.1637458 20.9966903,11.7495322 C20.9966903,11.3353187 20.6609039,10.9995322 20.2466903,10.9995322 L3.7547787,10.9995322 C3.34056514,10.9995322 3.0047787,11.3353187 3.0047787,11.7495322 C3.0047787,12.1637458 3.34056514,12.4995322 3.7547787,12.4995322 Z</StreamGeometry>
            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Light">
                    <SolidColorBrush x:Key="ForegroundBrush" Color="Black" />
                    <SolidColorBrush x:Key="CardBackgroundBrush" Color="#CCC" />
                </ResourceDictionary>
                <ResourceDictionary x:Key="Dark">
                    <SolidColorBrush x:Key="ForegroundBrush" Color="LightGray" />
                    <SolidColorBrush x:Key="CardBackgroundBrush" Color="#333" />
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>
    <UserControl.Styles>
        <Style Selector=".card TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource ForegroundBrush}" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <Style Selector=".card ic|SymbolIcon">
            <Setter Property="Foreground" Value="{DynamicResource ForegroundBrush}" />
        </Style>
        <Style Selector=".card TextBlock.title">
            <Setter Property="FontSize" Value="24" />
            <Setter Property="FontWeight" Value="Bold" />
        </Style>
        <Style Selector=".card TextBlock.subtitle">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="DemiBold" />
        </Style>
        <Style Selector=".card ic|SymbolIcon.subtitle">
            <Setter Property="FontSize" Value="12" />
        </Style>
        <Style Selector="Border.card-body">
            <Setter Property="Background" Value="{DynamicResource CardBackgroundBrush}" />
            <Setter Property="Padding" Value="5" />
        </Style>
    </UserControl.Styles>
    <Grid RowDefinitions="50,*" ColumnDefinitions="300,*" ColumnSpacing="10">
        <Button Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2" Classes="accent" HorizontalAlignment="Left" VerticalAlignment="Center" Command="{Binding LoadItemListCommand}">Charger</Button>
        <Label Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2" VerticalAlignment="Center" IsVisible="{Binding IsLoading}" Content="{Binding TreatmentStatus}" Margin="80,0,0,0" />
        
        <ListBox Grid.Row="1" Grid.Column="0" ItemsSource="{Binding BlueprintList}" SelectedItem="{Binding SelectedBluePrint}">
            <ListBox.ItemTemplate>
                <DataTemplate DataType="{x:Type vm:BlueprintViewModel}">
                    <Grid RowDefinitions="*" ColumnDefinitions="25,*,30">
                        <TextBlock Grid.Row="0" Grid.Column="0" Text="{Binding TierLevel, StringFormat=T{0}}" VerticalAlignment="Top" HorizontalAlignment="Center" />
                        <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding Name}"  VerticalAlignment="Top" HorizontalAlignment="Left" />
                        <TextBlock Grid.Row="0" Grid.Column="2" Text="{Binding RemainingUse, Converter={StaticResource MinusOneToInfinityConverter}, StringFormat='[{0}]'}"  VerticalAlignment="Top" HorizontalAlignment="Center" />
                    </Grid>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
        <StackPanel Grid.Row="1" Grid.Column="1" Width="400" HorizontalAlignment="Left" Spacing="10" Classes="card" IsVisible="{Binding SelectedBluePrint, Converter={x:Static ObjectConverters.IsNotNull}}">
            <Border Classes="card-body">
                <StackPanel>
                    <Grid ColumnDefinitions="Auto,*">
                        <Image Grid.Row="0" Grid.Column="0" Width="100" Height="100" VerticalAlignment="Top" Margin="0 5 10 5" Source="avares://StarXelem/Assets/equipement_introuvable.png" />
                        <StackPanel Grid.Row="0" Grid.Column="1" Spacing="3">
                            <TextBlock Classes="title" Text="{Binding SelectedBluePrint.Name}"/>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Classes="subtitle" Text="{Binding SelectedBluePrint.TierLevel, StringFormat='Tiers {0} | '}" />
                                <TextBlock Classes="subtitle" Text="{Binding SelectedBluePrint.RemainingUse, Converter={StaticResource MinusOneToInfinityConverter}, StringFormat='Usage restant : {0}'}" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" >
                                <ic:SymbolIcon Classes="subtitle" Symbol="Timer" Margin="0 0 5 0" />
                                <TextBlock Classes="subtitle" VerticalAlignment="Center" Text="{Binding SelectedBluePrint.CraftDuration}" />
                            </StackPanel>
                            
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>
            <ItemsControl ItemsSource="{Binding SelectedBluePrint.CategoryList}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type vm:BlueprintCategoryModel}">
                        <Border Margin="0 0 0 10" Classes="card-body">
                            <StackPanel>
                                <TextBlock Text="{Binding Name}" FontSize="14" />
                                <TextBlock>Ressources :</TextBlock>
                                <ItemsControl ItemsSource="{Binding MaterialList}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate DataType="{x:Type vm:BlueprintMaterialModel}">
                                            <StackPanel Margin="15 0 0 0" Orientation="Horizontal">
                                                <TextBlock Text="{Binding Name}" />
                                                <TextBlock Text="{Binding QuantityInScu, Converter={StaticResource MicroScuConverter}, StringFormat=' (quantité : {0})'}" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <TextBlock>Propriétés :</TextBlock>
                                <ItemsControl ItemsSource="{Binding StatModifierList}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate DataType="{x:Type vm:BlueprintStatModel}">
                                            <StackPanel Margin="15 0 0 0" Orientation="Horizontal">
                                                <TextBlock Text="{Binding Name}" />
                                                <TextBlock Text="{Binding Min, StringFormat=' (min : {0}'}" />
                                                <TextBlock Text="{Binding Min, StringFormat=', max : {0})'}" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </Grid>
</UserControl>
