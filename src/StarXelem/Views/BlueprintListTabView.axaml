<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:ic="clr-namespace:FluentIcons.Avalonia.Fluent;assembly=FluentIcons.Avalonia.Fluent"
             xmlns:vm="clr-namespace:StarXelem.ViewModels"
             xmlns:local="clr-namespace:StarXelem"
             xmlns:conv="clr-namespace:StarXelem.Converters"
             xmlns:comp="clr-namespace:StarXelem.Comparer"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:DataType="vm:BlueprintListTabViewModel"
             d:DataContext="{x:Static local:DesignData.BlueprintListTabViewModel}"
             x:Class="StarXelem.Views.BlueprintListTabView">
    <UserControl.Resources>
        <ResourceDictionary>
            <conv:HumanScuConverter x:Key="ScuConverter" />
            <conv:MinusOneToInfinityConverter x:Key="MinusOneToInfinityConverter" />
            <conv:PercentageConverter x:Key="PercentageConverter" />
            <conv:ResourceKeyToGeometryConverter x:Key="ResourceKeyToGeometryConverter" />
        </ResourceDictionary>
    </UserControl.Resources>
    <Grid RowDefinitions="*" ColumnDefinitions="Auto,300,Auto,*" Classes="master-detail">
    <Separator Grid.Row="0" Grid.Column="0" Classes="vertical" />
    <Grid Grid.Row="0" Grid.Column="1" Classes="master" RowDefinitions="Auto,Auto,Auto,*,Auto" ColumnDefinitions="*">
        <Grid Grid.Row="0" RowDefinitions="*,*,*" ColumnDefinitions="*,Auto">
            <TextBlock Grid.Column="0" Classes="title">BLUEPRINT</TextBlock>
            <Button Grid.Row="0" Grid.Column="1" Classes="btn principal" Command="{Binding LoadItemListCommand}">
                <Grid ColumnDefinitions="Auto,*,Auto">
                    <ic:SymbolIcon Grid.Column="0" Symbol="ArrowSync">
                        <ic:SymbolIcon.RenderTransform>
                            <RotateTransform Angle="90"/>
                        </ic:SymbolIcon.RenderTransform>
                    </ic:SymbolIcon>
                    <TextBlock Grid.Column="1">Charger</TextBlock>
                </Grid>
            </Button>
            <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="6" Margin="0 4 0 0">
                <CheckBox Content="Afficher uniquement les BP obtenus" 
                          IsChecked="{Binding ShowOnlyObtained}" 
                          IsEnabled="{Binding IsGrpcConnected}" />
            </StackPanel>
        </Grid>
        <RelativePanel Grid.Row="1" >
            <TextBox Name="Search" RelativePanel.AlignLeftWithPanel="True" RelativePanel.AlignRightWithPanel="True" Padding="28 0 28 0" VerticalContentAlignment="Center" HorizontalAlignment="Stretch" Text="{Binding Search, UpdateSourceTrigger=PropertyChanged}" />
            <Label Target="Search" RelativePanel.AlignLeftWith="Search" RelativePanel.AlignVerticalCenterWith="Search">
                <ic:SymbolIcon  Margin="2 0 0 0" Symbol="Search" />
            </Label>
            <Button Classes="btn icon" RelativePanel.AlignVerticalCenterWith="Search" RelativePanel.AlignRightWith="Search" Margin="0 0 4 0" Command="{Binding ClearSearchCommand}" IsVisible="{Binding Search, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" >
                <ic:SymbolIcon Symbol="DismissCircle" />
            </Button>
        </RelativePanel>
        <Separator Grid.Row="2" Classes="horizontal" />
        <ListBox Grid.Row="3" Classes="bp-list" ItemsSource="{Binding BlueprintList}" SelectedItem="{Binding SelectedBluePrint}">
            <ListBox.DataTemplates>
                <DataTemplate DataType="{x:Type vm:BlueprintViewModel}">
                    <Grid Classes="bp-list-row" RowDefinitions="*" ColumnDefinitions="Auto,*,Auto">
                        <Grid.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="Copier GUID" Command="{Binding CopyIdCommand}" />
                            </ContextMenu>
                        </Grid.ContextMenu>
                        <Border Classes="badge tiers-1" Grid.Row="0" Grid.Column="0">
                            <TextBlock Text="{Binding TierLevel, StringFormat=T{0}}" />
                        </Border>
                        <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding Name}" />
                        <TextBlock Grid.Row="0" Grid.Column="2" Text="{Binding RemainingUse, Converter={StaticResource MinusOneToInfinityConverter}}" />
                    </Grid>
                </DataTemplate>
            </ListBox.DataTemplates>
        </ListBox>
        <Button Grid.Row="4" Classes="btn export" Command="{Binding SendToOrbitalAllianceCommand}" Margin="5 15" HorizontalAlignment="Center" >
            <Grid ColumnDefinitions="Auto,*">
                <ic:SymbolIcon Grid.Column="0" Symbol="ArrowUpload" Margin=" 0 0 10 0">
                    <ic:SymbolIcon.RenderTransform>
                        <RotateTransform Angle="45"/>
                    </ic:SymbolIcon.RenderTransform>
                </ic:SymbolIcon>
                <TextBlock Grid.Column="1">Envoi Orbital Alliance</TextBlock>
            </Grid>
        </Button>

    </Grid>
    <Separator Grid.Row="0" Grid.Column="2" Classes="vertical" />
    <StackPanel Grid.Row="0" Grid.Column="3" Classes="detail" Margin="0" IsVisible="{Binding SelectedBluePrint, Converter={x:Static ObjectConverters.IsNotNull}}" >
        <Border Classes="header">
            <Grid ColumnDefinitions="Auto,*" RowDefinitions="20,Auto,*" VerticalAlignment="Stretch" HorizontalAlignment="Stretch" >
                <Border Grid.Row="0" Grid.RowSpan="3" Grid.Column="0" Classes="equipment-icon">
                    <!-- TODO comment choisir le bon item ? Binding ? -->
                    <Path Name="ItemType" Data="{Binding SelectedBluePrint.ItemIconKey, Converter={StaticResource ResourceKeyToGeometryConverter}}" />
                </Border>
                <TextBlock Grid.Row="1" Grid.Column="1" Classes="title" Text="{Binding SelectedBluePrint.Name}" />
                <WrapPanel Grid.Row="2" Grid.Column="1">
                    <Border Classes="badge tiers-1">
                        <TextBlock Text="{Binding SelectedBluePrint.TierLevel, StringFormat='Tiers {0}'}" />
                    </Border>
                    <Border Classes="badge usage">
                        <TextBlock Text="{Binding SelectedBluePrint.RemainingUse, Converter={StaticResource MinusOneToInfinityConverter}, StringFormat='\{0} Utilisations'}" />
                    </Border>
                    <Border Classes="badge temps">
                        <Grid ColumnDefinitions="Auto,Auto,Auto">
                            <ic:SymbolIcon Grid.Column="0" Symbol="Timer" />
                            <TextBlock Grid.Column="1" Text="{Binding SelectedBluePrint.CraftDuration}" />
                        </Grid>
                    </Border>
                </WrapPanel>
            </Grid>
        </Border>
        <Separator Classes="horizontal" />
        <ItemsControl Classes="content" ItemsSource="{Binding SelectedBluePrint.CategoryList}">
            <ItemsControl.DataTemplates>
                <DataTemplate DataType="{x:Type vm:BlueprintCategoryModel}">
                    <Border Classes="card">
                        <Grid RowDefinitions="Auto,Auto,*">
                            <TextBlock Grid.Row="0" Grid.Column="0" Classes="h1 demi-bold" Text="{Binding Name}" />
                            <Separator Grid.Row="1" Grid.Column="0" Classes="horizontal" />
                            <Grid Grid.Row="2" Grid.Column="0" RowDefinitions="Auto,*" ColumnDefinitions="*,Auto,*">
                                <TextBlock Grid.Row="0" Grid.Column="0" Classes="h1 dimming bold">Ressources</TextBlock>
                                <ItemsControl Grid.Row="1" Grid.Column="0" ItemsSource="{Binding MaterialList}">
                                    <ItemsControl.DataTemplates>
                                        <!-- Ressource brute en SCU (ex : Fer 0,2 SCU) -->
                                        <DataTemplate DataType="{x:Type vm:BlueprintResourceModel}">
                                            <Grid ColumnDefinitions="Auto,*,Auto">
                                                <Border Grid.Column="0" Classes="bulletpoint" />
                                                <TextBlock Grid.Column="1" Classes="demi-dimming" Text="{Binding Name}" />
                                                <TextBlock Grid.Column="2" Classes="demi-bold" Text="{Binding QuantityInScu, Converter={StaticResource ScuConverter}}" />
                                            </Grid>
                                        </DataTemplate>

                                        <!-- Objet en quantité physique (ex : minerai Sadaryx 4 unités) -->
                                        <DataTemplate DataType="{x:Type vm:BlueprintItemModel}">
                                            <Grid ColumnDefinitions="Auto,*,Auto">
                                                <Border Grid.Column="0" Classes="bulletpoint" />
                                                <TextBlock Grid.Column="1" Classes="demi-dimming" Text="{Binding Name}" />
                                                <TextBlock Grid.Column="2" Classes="demi-bold" Text="{Binding QuantityCount, StringFormat='\{0} unités'}" />
                                            </Grid>
                                        </DataTemplate>

                                        <!-- Repli pour tout sous-type inconnu : affiche le nom sans quantité -->
                                        <DataTemplate DataType="{x:Type vm:BlueprintMaterialModel}">
                                            <Grid ColumnDefinitions="Auto,*,Auto">
                                                <Border Grid.Column="0" Classes="bulletpoint" />
                                                <TextBlock Grid.Column="1" Classes="demi-dimming" Text="{Binding Name}" />
                                                <TextBlock Grid.Column="2" Classes="demi-bold" Text="(type inconnu)" />
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.DataTemplates>
                                </ItemsControl>
                                <Separator Grid.Row="0" Grid.RowSpan="2" Grid.Column="1" Classes="vertical spacer" />
                                <TextBlock Grid.Row="0" Grid.Column="2" Classes="h1 dimming bold">Propriétés :</TextBlock>
                                <ItemsControl Grid.Row="1" Grid.Column="2" ItemsSource="{Binding StatModifierList}">
                                    <ItemsControl.DataTemplates>

                                        <!-- Modificateur multiplicatif linéaire (ex: 80% → 120%) -->
                                        <DataTemplate DataType="{x:Type vm:BlueprintStatLinearModel}">
                                            <Grid ColumnDefinitions="*,Auto">
                                                <TextBlock Grid.Column="0" Classes="demi-dimming" Text="{Binding Name}" />
                                                <Grid Grid.Column="1" ColumnDefinitions="Auto,25,Auto">
                                                    <TextBlock Grid.Column="0" Classes="demi-bold" Text="{Binding Min, Converter={StaticResource PercentageConverter}, ConverterParameter=4}" />
                                                    <Separator Grid.Column="1" Classes="horizontal" Margin="5 0" />
                                                    <TextBlock Grid.Column="2" Classes="demi-bold" Text="{Binding Max, Converter={StaticResource PercentageConverter}, ConverterParameter=4}" />
                                                </Grid>
                                            </Grid>
                                        </DataTemplate>

                                        <!-- Modificateur additif entier par plages de qualité (ex: -2 | -1 | 0 | +1 | +2) -->
                                        <DataTemplate DataType="{x:Type vm:BlueprintStatAdditiveModel}">
                                            <Grid RowDefinitions="Auto,Auto" Margin="0 2 0 4">
                                                <TextBlock Grid.Row="0" Classes="demi-dimming" Text="{Binding Name}" />
                                                <ItemsControl Grid.Row="1" ItemsSource="{Binding Bands}" Margin="0 2 0 0">
                                                    <ItemsControl.ItemsPanel>
                                                        <ItemsPanelTemplate>
                                                            <StackPanel Orientation="Horizontal" Spacing="6" />
                                                        </ItemsPanelTemplate>
                                                    </ItemsControl.ItemsPanel>
                                                    <ItemsControl.DataTemplates>
                                                        <DataTemplate DataType="{x:Type vm:BlueprintStatBandModel}">
                                                            <StackPanel Orientation="Vertical" Spacing="1">
                                                                <TextBlock Classes="demi-dimming quality-label demi-bold" Text="{Binding QualityLabel}" HorizontalAlignment="Center" />
                                                                <TextBlock Classes="demi-bold" Text="{Binding FormattedValue}" HorizontalAlignment="Center" />
                                                            </StackPanel>
                                                        </DataTemplate>
                                                    </ItemsControl.DataTemplates>
                                                </ItemsControl>
                                            </Grid>
                                        </DataTemplate>

                                    </ItemsControl.DataTemplates>
                                </ItemsControl>
                            </Grid>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ItemsControl.DataTemplates>
        </ItemsControl>
        <Separator Classes="horizontal" />
        <ItemsControl Classes="content" ItemsSource="{Binding SelectedBluePrint.MissionPools}">
            <ItemsControl.DataTemplates>
                <DataTemplate DataType="vm:MissionPoolInfo">
                    <Border Classes="card">
                        <Grid RowDefinitions="Auto,Auto,*">
                            <TextBlock Grid.Row="0" Classes="h1 demi-bold" Text="{Binding PoolName}" />
                            <Separator Grid.Row="1" Classes="horizontal" />
                            <TextBlock Grid.Row="2" Classes="demi-dimming" 
                                       Text="{Binding MissionTitle}" 
                                       TextWrapping="Wrap" />
                        </Grid>
                    </Border>
                </DataTemplate>
            </ItemsControl.DataTemplates>
        </ItemsControl>
    </StackPanel>
</Grid>

</UserControl>
