<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:StarXelem.ViewModels"
             xmlns:models="clr-namespace:StarXelem.Models"
             xmlns:local="clr-namespace:StarXelem"
             xmlns:conv="clr-namespace:StarXelem.Converters"
             xmlns:comp="clr-namespace:StarXelem.Components"
             xmlns:ui="clr-namespace:FluentAvalonia.UI.Controls;assembly=FluentAvalonia"
             mc:Ignorable="d" d:DesignWidth="1300" d:DesignHeight="800"
             x:DataType="vm:P4kShipTabViewModel"
             d:DataContext="{x:Static local:DesignData.P4kShipTabViewModel}"
             x:Class="StarXelem.Views.P4kShipTabView">
    <UserControl.Styles>
        <!-- Liste des vaisseaux : lignes à angles coupés, sélection en accent doux -->
        <Style Selector="ListBox.ship-list">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
        </Style>
        <Style Selector="ListBox.ship-list ListBoxItem">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource Sx.TextBrush}" />
            <Setter Property="Padding" Value="12,10" />
            <Setter Property="Margin" Value="0,0,0,2" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <ControlTemplate TargetType="ListBoxItem">
                    <comp:NotchedBorder CutSize="9" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                        <ContentPresenter Content="{TemplateBinding Content}"
                                          ContentTemplate="{TemplateBinding ContentTemplate}"
                                          HorizontalContentAlignment="Stretch" />
                    </comp:NotchedBorder>
                </ControlTemplate>
            </Setter>
        </Style>
        <Style Selector="ListBox.ship-list ListBoxItem:pointerover">
            <Setter Property="Background" Value="{DynamicResource Sx.ReliefBrush}" />
        </Style>
        <Style Selector="ListBox.ship-list ListBoxItem:selected">
            <Setter Property="Background" Value="{DynamicResource Sx.AccentSoftBrush}" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>

        <!-- Carte d'un type de composant -->
        <Style Selector="comp|NotchedBorder.component-card">
            <Setter Property="CutSize" Value="14" />
            <Setter Property="Padding" Value="18,14" />
            <Setter Property="Margin" Value="0,0,12,12" />
            <Setter Property="Background" Value="{DynamicResource Sx.ReliefBrush}" />
        </Style>
        <Style Selector="TextBlock.card-title">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="Medium" />
            <Setter Property="Foreground" Value="{DynamicResource Sx.SecondaryBrush}" />
            <Setter Property="Margin" Value="0,0,0,6" />
        </Style>

        <!-- Tableaux armes, missiles et points d'emport -->
        <Style Selector="TextBlock.section-title">
            <Setter Property="FontSize" Value="16" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource Sx.TextBrush}" />
            <Setter Property="Margin" Value="0,6,0,2" />
        </Style>
        <Style Selector="Border.table-head">
            <Setter Property="BorderBrush" Value="{DynamicResource Sx.LineBrush}" />
            <Setter Property="BorderThickness" Value="0,0,0,1" />
            <Setter Property="Padding" Value="0,11" />
        </Style>
        <Style Selector="Border.table-head TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="Medium" />
            <Setter Property="Foreground" Value="{DynamicResource Sx.SecondaryBrush}" />
        </Style>
        <Style Selector="Border.table-row">
            <Setter Property="BorderBrush" Value="{DynamicResource Sx.LineBrush}" />
            <Setter Property="BorderThickness" Value="0,0,0,1" />
            <Setter Property="MinHeight" Value="42" />
        </Style>
        <Style Selector="Border.table-row TextBlock">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Foreground" Value="{DynamicResource Sx.TextBrush}" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        </Style>
        <Style Selector="Border.table-row TextBlock.name">
            <Setter Property="FontWeight" Value="Medium" />
        </Style>
        <Style Selector="Border.table-row TextBlock.muted">
            <Setter Property="Foreground" Value="{DynamicResource Sx.SecondaryBrush}" />
        </Style>
        <Style Selector="Border.table-row TextBlock.mono">
            <Setter Property="FontFamily" Value="{DynamicResource Sx.FontMono}" />
        </Style>
    </UserControl.Styles>

    <!-- La nouvelle charte n'existe qu'en thème sombre : l'écran reste sombre même si Windows est en thème clair. -->
    <ThemeVariantScope RequestedThemeVariant="Dark">
        <Grid Background="{DynamicResource Sx.BackgroundBrush}" TextElement.FontFamily="{DynamicResource Sx.FontSans}">
        <Grid ColumnDefinitions="300,*" ColumnSpacing="12" Margin="12">

            <!-- Liste des vaisseaux -->
            <comp:NotchedBorder CutSize="18" Background="{DynamicResource Sx.SurfaceBrush}" Padding="14,18,14,14">
                <Grid RowDefinitions="Auto,Auto,Auto,Auto,*" RowSpacing="12">
                    <StackPanel Margin="6,0" Spacing="2">
                        <TextBlock Classes="sx-title" Text="Loadout vaisseaux" />
                        <TextBlock Classes="sx-caption" Text="{Binding ResultSummary}" />
                    </StackPanel>

                    <comp:NotchedBorder Grid.Row="1" Classes="sx-field">
                        <Grid ColumnDefinitions="Auto,*">
                            <Path Classes="sx-search-icon" Margin="12,0,0,0" />
                            <TextBox Grid.Column="1"
                                     Classes="sx"
                                     Height="44"
                                     Watermark="Vaisseau, constructeur..."
                                     Text="{Binding Search}" />
                        </Grid>
                    </comp:NotchedBorder>

                    <!-- Constructeurs : cumulables, « Tous » retire le filtre. Hauteur bornée : une vingtaine de puces. -->
                    <ScrollViewer Grid.Row="2" MaxHeight="128" VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding ManufacturerChips}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:FilterChipViewModel">
                                    <Button Classes="sx-chip" Classes.on="{Binding IsSelected}" Command="{Binding ToggleCommand}">
                                        <StackPanel Orientation="Horizontal" Spacing="7">
                                            <TextBlock Text="{Binding Label}" VerticalAlignment="Center" />
                                            <TextBlock Classes="sx-count" Text="{Binding Count}" />
                                        </StackPanel>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>

                    <CheckBox Grid.Row="3"
                              Classes="sx-muted"
                              Margin="6,0"
                              Content="Inclure les vaisseaux masqués"
                              ToolTip.Tip="Vaisseaux présents dans les données du jeu mais absents des listes en jeu"
                              IsChecked="{Binding IncludeHidden}" />

                    <Grid Grid.Row="4">
                        <ListBox Classes="ship-list" ItemsSource="{Binding Ships}" SelectedItem="{Binding SelectedShip}">
                            <ListBox.ItemTemplate>
                                <DataTemplate x:DataType="models:P4kShipModel">
                                    <TextBlock Background="Transparent"
                                               Text="{Binding Name}"
                                               TextTrimming="CharacterEllipsis"
                                               ToolTip.Tip="{Binding TechnicalName}" />
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>

                        <TextBlock Classes="sx-caption"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   TextWrapping="Wrap"
                                   TextAlignment="Center"
                                   IsVisible="{Binding ShowNoMatch}"
                                   Text="Aucun vaisseau ne correspond à ces filtres." />

                        <!-- Indicateur de chargement / filtrage, superposé à la liste -->
                        <Grid IsVisible="{Binding IsBusy}" IsHitTestVisible="False">
                            <Border Background="{DynamicResource Sx.SurfaceBrush}" Opacity="0.75" />
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="10" Margin="12,0">
                                <ui:ProgressRing IsIndeterminate="True" Width="40" Height="40" HorizontalAlignment="Center" />
                                <TextBlock Classes="sx-caption" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" Text="{Binding BusyMessage}" />
                            </StackPanel>
                        </Grid>
                    </Grid>
                </Grid>
            </comp:NotchedBorder>

            <!-- Loadout du vaisseau sélectionné -->
            <comp:NotchedBorder Grid.Column="1" CutSize="18" Background="{DynamicResource Sx.SurfaceBrush}">
                <Grid>
                    <TextBlock Classes="sx-caption"
                               FontSize="13"
                               Margin="28,26"
                               IsVisible="{Binding !HasSelection}"
                               Text="Sélectionnez un vaisseau dans la liste pour afficher son loadout." />

                    <ScrollViewer VerticalScrollBarVisibility="Auto" IsVisible="{Binding HasSelection}">
                        <StackPanel Margin="28,26" Spacing="14">
                            <!-- En-tête : nom et tags du jeu -->
                            <StackPanel Spacing="10">
                                <TextBlock FontSize="30"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource Sx.TextBrush}"
                                           TextWrapping="Wrap"
                                           Text="{Binding SelectedShip.Name, FallbackValue=''}" />
                                <ItemsControl ItemsSource="{Binding SelectedShip.TagNames, FallbackValue={x:Null}}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="x:String">
                                            <comp:NotchedBorder Classes="sx-badge" Margin="0,0,6,6">
                                                <TextBlock FontWeight="Normal" Text="{Binding}" />
                                            </comp:NotchedBorder>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>

                            <!-- Composants : une carte par type, autant de colonnes de 320 px que la largeur le permet -->
                            <ItemsControl ItemsSource="{Binding ComponentSections}" Margin="0,0,-12,-12">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <UniformGrid Columns="{Binding $parent[ItemsControl].Bounds.Width, Converter={x:Static conv:WidthToColumnsConverter.Instance}, ConverterParameter=320}" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="models:P4kShipComponentSection">
                                        <comp:NotchedBorder Classes="component-card">
                                            <StackPanel>
                                                <TextBlock Classes="card-title" Text="{Binding Title}" />
                                                <ItemsControl ItemsSource="{Binding Components}">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate x:DataType="models:P4kShipComponentModel">
                                                            <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="10" Margin="0,6">
                                                                <TextBlock FontWeight="Medium"
                                                                           VerticalAlignment="Center"
                                                                           Foreground="{DynamicResource Sx.TextBrush}"
                                                                           TextTrimming="CharacterEllipsis"
                                                                           ToolTip.Tip="{Binding PortName}"
                                                                           Text="{Binding DisplayName}" />
                                                                <TextBlock Grid.Column="1"
                                                                           VerticalAlignment="Center"
                                                                           Foreground="{DynamicResource Sx.SecondaryBrush}"
                                                                           Text="{Binding DetailLabel}" />
                                                                <comp:NotchedBorder Grid.Column="2"
                                                                                    Classes="sx-badge"
                                                                                    Classes.success="{Binding IsGradeA}"
                                                                                    Classes.info="{Binding IsGradeB}"
                                                                                    Classes.warning="{Binding IsGradeC}"
                                                                                    Classes.danger="{Binding IsGradeLow}"
                                                                                    IsVisible="{Binding HasGrade}"
                                                                                    ToolTip.Tip="Grade">
                                                                    <StackPanel Orientation="Horizontal" Spacing="7">
                                                                        <Ellipse />
                                                                        <TextBlock Text="{Binding Grade}" />
                                                                    </StackPanel>
                                                                </comp:NotchedBorder>
                                                            </Grid>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </StackPanel>
                                        </comp:NotchedBorder>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <!-- Armes -->
                            <StackPanel IsVisible="{Binding HasWeapons}">
                                <TextBlock Classes="section-title" Text="Armes" />
                                <Border Classes="table-head">
                                    <Grid ColumnDefinitions="*,80,200,100" ColumnSpacing="12">
                                        <TextBlock Text="Nom" />
                                        <TextBlock Grid.Column="1" Text="Taille" />
                                        <TextBlock Grid.Column="2" Text="Type" />
                                        <TextBlock Grid.Column="3" Text="Dégâts" />
                                    </Grid>
                                </Border>
                                <ItemsControl ItemsSource="{Binding WeaponList}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="models:P4kShipComponentModel">
                                            <Border Classes="table-row">
                                                <Grid ColumnDefinitions="*,80,200,100" ColumnSpacing="12">
                                                    <TextBlock Classes="name" Text="{Binding DisplayName}" ToolTip.Tip="{Binding PortName}" />
                                                    <TextBlock Grid.Column="1" Classes="mono" Text="{Binding SizeLabel}" />
                                                    <TextBlock Grid.Column="2" Classes="muted" Text="{Binding WeaponTypeLabel}" />
                                                    <TextBlock Grid.Column="3" Classes="mono" Text="{Binding DamageLabel}" ToolTip.Tip="Dégâts par tir" />
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>

                            <!-- Missiles -->
                            <StackPanel IsVisible="{Binding HasMissiles}">
                                <TextBlock Classes="section-title" Text="Missiles" />
                                <Border Classes="table-head">
                                    <Grid ColumnDefinitions="*,80,200,100" ColumnSpacing="12">
                                        <TextBlock Text="Nom" />
                                        <TextBlock Grid.Column="1" Text="Taille" />
                                        <TextBlock Grid.Column="2" Text="Guidage" />
                                        <TextBlock Grid.Column="3" Text="Classe" />
                                    </Grid>
                                </Border>
                                <ItemsControl ItemsSource="{Binding MissileList}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="models:P4kShipComponentModel">
                                            <Border Classes="table-row">
                                                <Grid ColumnDefinitions="*,80,200,100" ColumnSpacing="12">
                                                    <TextBlock Classes="name" Text="{Binding DisplayName}" ToolTip.Tip="{Binding PortName}" />
                                                    <TextBlock Grid.Column="1" Classes="mono" Text="{Binding SizeLabel}" />
                                                    <TextBlock Grid.Column="2" Classes="muted" Text="{Binding GuidanceLabel}" />
                                                    <TextBlock Grid.Column="3" Classes="muted" Text="{Binding ComponentClassLabel}" />
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>

                            <!-- Liste brute de tous les points d'emport, repliée par défaut -->
                            <StackPanel Spacing="8">
                                <Button Classes="sx small" HorizontalAlignment="Left" Command="{Binding TogglePortsCommand}" Content="{Binding PortsToggleLabel}" />
                                <StackPanel IsVisible="{Binding ShowAllPorts}">
                                    <Border Classes="table-head">
                                        <Grid ColumnDefinitions="2*,160,3*" ColumnSpacing="12">
                                            <TextBlock Text="Point d'emport" />
                                            <TextBlock Grid.Column="1" Text="Classe" />
                                            <TextBlock Grid.Column="2" Text="Composant" />
                                        </Grid>
                                    </Border>
                                    <ItemsControl ItemsSource="{Binding Components}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="models:P4kShipComponentModel">
                                                <Border Classes="table-row" MinHeight="34">
                                                    <Grid ColumnDefinitions="2*,160,3*" ColumnSpacing="12">
                                                        <TextBlock Classes="mono muted" FontSize="12" Text="{Binding PortName}" ToolTip.Tip="{Binding PortName}" />
                                                        <TextBlock Grid.Column="1" Classes="muted" Text="{Binding ComponentClassLabel}" />
                                                        <TextBlock Grid.Column="2" Text="{Binding DisplayName}" />
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </comp:NotchedBorder>
        </Grid>
        </Grid>
    </ThemeVariantScope>
</UserControl>
