<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:ic="clr-namespace:FluentIcons.Avalonia.Fluent;assembly=FluentIcons.Avalonia.Fluent"
             xmlns:vm="clr-namespace:StarXelem.ViewModels"
             xmlns:local="clr-namespace:StarXelem"
             xmlns:models="clr-namespace:StarXelem.Models"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:DataType="vm:ShipTabViewModel"
             d:DataContext="{x:Static local:DesignData.ShipTabViewModel}"
             x:Class="StarXelem.Views.ShipTabView">
    <Grid RowDefinitions="Auto,*" Classes="main">
        <Grid Grid.Row="0" Classes="header" ColumnDefinitions="Auto,Auto,*" ColumnSpacing="10">
            <!-- Groupe boutons gauche : Sync Flotte + Actualiser -->
            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="5">
                <Button Classes="btn export" Command="{Binding SendFleetToOrbitalAllianceCommand}">
                    <Grid ColumnDefinitions="Auto,*">
                        <ic:SymbolIcon Grid.Column="0" Symbol="ArrowUpload">
                            <ic:SymbolIcon.RenderTransform>
                                <RotateTransform Angle="45"/>
                            </ic:SymbolIcon.RenderTransform>
                        </ic:SymbolIcon>
                        <TextBlock Grid.Column="1">Sync Flotte</TextBlock>
                    </Grid>
                </Button>
                <Button Classes="btn principal" Command="{Binding LoadShipListCommand}">
                    <Grid ColumnDefinitions="Auto,*">
                        <ic:SymbolIcon Grid.Column="0" Symbol="ArrowSync">
                            <ic:SymbolIcon.RenderTransform>
                                <RotateTransform Angle="90"/>
                            </ic:SymbolIcon.RenderTransform>
                        </ic:SymbolIcon>
                        <TextBlock Grid.Column="1">Actualiser</TextBlock>
                    </Grid>
                </Button>
            </StackPanel>
            <TextBlock Grid.Column="1" Classes="dimming" VerticalAlignment="Center" IsVisible="{Binding IsLoading}" Text="{Binding TreatmentStatus}" />
            <Grid Grid.Column="2" HorizontalAlignment="Right" ColumnDefinitions="Auto,Auto" VerticalAlignment="Center">
                <TextBlock Grid.Column="0" Classes="demi-dimming" Text="{Binding Spaceships^.Count, FallbackValue=-}" Margin="0 0 7 0" />
                <TextBlock Grid.Column="1" Classes="dimming" >Vaisseaux</TextBlock>
            </Grid>
        </Grid>
        <Grid Grid.Row="1">
            <DataGrid  ItemsSource="{Binding Spaceships^}" AutoGenerateColumns="False" IsReadOnly="True" >
                <DataGrid.Columns>
                    <DataGridTextColumn Header="NOM" Binding="{Binding Name}" />
                    <DataGridTextColumn Header="MODÈLE" Binding="{Binding Shipname}" CellStyleClasses="demi-dimming" />
                    <DataGridTemplateColumn Header="STORE" MinWidth="0" SortMemberPath="IsRealPurchase">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate DataType="{x:Type models:SpaceshipModel}">
                                <Ellipse Classes="status-indicator" Classes.connected="{Binding IsRealPurchase}"
                                         Width="8" Height="8" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTemplateColumn Header="STATUT" SortMemberPath="DisplayState">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate DataType="{x:Type models:SpaceshipModel}">
                                <Border Classes="badge"
                                        Classes.tiers-1="{Binding IsStowed}"
                                        Classes.arenaCommander="{Binding IsUnstowed}"
                                        Classes.usage="{Binding IsUnclaimed}"
                                        Classes.destroyed="{Binding IsDestroyed}"
                                        HorizontalAlignment="Left" Margin="15,0">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <Ellipse Width="7" Height="7" VerticalAlignment="Center" />
                                        <TextBlock Text="{Binding DisplayState}" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTemplateColumn Header="EMPLACEMENT">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate DataType="{x:Type models:SpaceshipModel}">
                                <Grid ColumnDefinitions="Auto,*" VerticalAlignment="Center" Margin="15,10" ColumnSpacing="6">
                                    <TextBlock Grid.Column="0" Grid.ColumnSpan="2" IsVisible="{Binding IsEmptyLocation}" Classes="dimming" Text="—" VerticalAlignment="Center" />
                                    <Border Grid.Column="0" Classes="badge arenaCommander" IsVisible="{Binding IsPorte}" VerticalAlignment="Center" Padding="4.5">
                                        <ic:SymbolIcon Symbol="Person" FontSize="14" VerticalAlignment="Center" />
                                    </Border>
                                    <Border Grid.Column="0" Classes="badge regionEurope" IsVisible="{Binding IsLocationTypeLocation}" Padding="4.5">
                                        <ic:SymbolIcon Symbol="Home" FontSize="14" VerticalAlignment="Center" />
                                    </Border>
                                    <Border Grid.Column="0" Classes="badge tiers-1" IsVisible="{Binding IsLocationTypeHangar}" Padding="4.5">
                                        <ic:SymbolIcon Symbol="Location" FontSize="14" VerticalAlignment="Center" />
                                    </Border>
                                    <Border Grid.Column="0" Classes="badge arenaCommander" IsVisible="{Binding IsLocationTypeId}" Padding="4.5">
                                        <ic:SymbolIcon Symbol="VehicleShip" FontSize="14" VerticalAlignment="Center" />
                                    </Border>
                                    <Border Grid.Column="0" Classes="badge offline" IsVisible="{Binding IsLocationTypeOther}" HorizontalAlignment="Left" Padding="4.5">
                                        <ic:SymbolIcon Symbol="Question" FontSize="14" VerticalAlignment="Center" />
                                    </Border>
                                    <TextBlock Grid.Column="1" Text="Logout dedans" VerticalAlignment="Center" IsVisible="{Binding IsPorte}" />
                                    <TextBlock Grid.Column="1" Text="{Binding LocationName}" VerticalAlignment="Center" IsVisible="{Binding IsLocationTypeLocation}" />
                                    <TextBlock Grid.Column="1" Text="{Binding LocationName}" VerticalAlignment="Center" IsVisible="{Binding IsLocationTypeHangar}" />
                                    <TextBlock Grid.Column="1" Text="{Binding LocationName}" VerticalAlignment="Center" IsVisible="{Binding IsLocationTypeId}" />
                                    <TextBlock Grid.Column="1" Text="{Binding ReadableLocation}" VerticalAlignment="Center" IsVisible="{Binding IsLocationTypeOther}" />

                                </Grid>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Header="SHARD" Binding="{Binding Shard}" />
                </DataGrid.Columns>
            </DataGrid>
        </Grid>
    </Grid>
</UserControl>
