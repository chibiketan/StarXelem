<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:StarXelem.ViewModels"
             xmlns:local="clr-namespace:StarXelem"
             xmlns:models="clr-namespace:StarXelem.Models"
             xmlns:conv="clr-namespace:StarXelem.Converters"
             xmlns:comp="clr-namespace:StarXelem.Components"
             xmlns:ui="clr-namespace:FluentAvalonia.UI.Controls;assembly=FluentAvalonia"
             mc:Ignorable="d" d:DesignWidth="1300" d:DesignHeight="800"
             x:DataType="vm:ItemsTabViewModel"
             d:DataContext="{x:Static local:DesignData.ItemsTabViewModel}"
             x:Class="StarXelem.Views.ItemsTabView">
    <UserControl.Resources>
        <conv:MicroScuConverter x:Key="MicroScuConverter" />
    </UserControl.Resources>
    <UserControl.Styles>
        <Style Selector="Grid.detail-row">
            <Setter Property="Margin" Value="0,0,0,10" />
        </Style>
        <Style Selector="Grid.detail-row > TextBlock:nth-child(2)">
            <Setter Property="Foreground" Value="{DynamicResource Sx.TextBrush}" />
            <Setter Property="HorizontalAlignment" Value="Right" />
            <Setter Property="TextAlignment" Value="Right" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Margin" Value="16,0,0,0" />
        </Style>
    </UserControl.Styles>

    <!-- La nouvelle charte n'existe qu'en thème sombre : l'écran reste sombre même si Windows est en thème clair. -->
    <ThemeVariantScope RequestedThemeVariant="Dark">
        <ThemeVariantScope.Resources>
            <!-- Le tri est géré par comp:ColumnHeader : l'icône native du tableau ne doit pas réserver de place. -->
            <x:Double x:Key="DataGridSortIconMinWidth">0</x:Double>
            <SolidColorBrush x:Key="CheckBoxCheckBackgroundFillChecked" Color="#FFE8B04A" />
            <SolidColorBrush x:Key="CheckBoxCheckBackgroundFillCheckedPointerOver" Color="#D9E8B04A" />
            <SolidColorBrush x:Key="CheckBoxCheckBackgroundFillCheckedPressed" Color="#D9E8B04A" />
            <SolidColorBrush x:Key="CheckBoxCheckBackgroundStrokeChecked" Color="#FFE8B04A" />
            <SolidColorBrush x:Key="CheckBoxCheckBackgroundStrokeCheckedPointerOver" Color="#D9E8B04A" />
            <SolidColorBrush x:Key="CheckBoxCheckBackgroundStrokeCheckedPressed" Color="#D9E8B04A" />
            <SolidColorBrush x:Key="CheckBoxCheckGlyphForegroundChecked" Color="#FF0B0D12" />
            <SolidColorBrush x:Key="CheckBoxCheckGlyphForegroundCheckedPointerOver" Color="#FF0B0D12" />
            <SolidColorBrush x:Key="CheckBoxCheckGlyphForegroundCheckedPressed" Color="#FF0B0D12" />
        </ThemeVariantScope.Resources>

        <Grid Background="{DynamicResource Sx.BackgroundBrush}"
              ColumnDefinitions="*,12,320"
              Margin="0"
              TextElement.FontFamily="{DynamicResource Sx.FontSans}">

            <!-- Bloc principal -->
            <comp:NotchedBorder Grid.Column="0" Margin="12,12,0,12" CutSize="18" Background="{DynamicResource Sx.SurfaceBrush}">
                <Grid RowDefinitions="Auto,Auto,Auto,*">

                    <!-- Barre d'outils -->
                    <Border Grid.Row="0" BorderBrush="{DynamicResource Sx.LineBrush}" BorderThickness="0,0,0,1" Padding="20,14">
                        <Grid ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="12">
                            <TextBlock Classes="sx-title" Text="Objets" Margin="0,0,8,0" />

                            <comp:NotchedBorder Grid.Column="1" Classes="sx-field" MinWidth="180">
                                <Grid ColumnDefinitions="Auto,*">
                                    <Path Classes="sx-search-icon" Margin="12,0,0,0" />
                                    <TextBox Grid.Column="1"
                                             Classes="sx"
                                             Height="44"
                                             Watermark="Filtrer par nom, type, emplacement..."
                                             Text="{Binding NameFilter}" />
                                </Grid>
                            </comp:NotchedBorder>

                            <TextBlock Grid.Column="2" Classes="sx-caption" Text="{Binding ResultSummary}" />

                            <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="8">
                                <CheckBox Classes="sx-muted" Content="Debug" IsChecked="{Binding IsInDebugMode}" />
                                <Button Classes="sx"
                                        ToolTip.Tip="Comparaison depuis un export"
                                        Command="{Binding CompareDataFromImportCommand}">Comparer</Button>
                                <Button Classes="sx" Command="{Binding ExportToExcelCommand}">Exporter Excel</Button>
                                <Button Classes="sx"
                                        ToolTip.Tip="Synchroniser la liste d'objets avec Orbital Alliance"
                                        Command="{Binding SendItemlistToOrbitalAllianceCommand}">Synchroniser</Button>
                                <Button Classes="sx primary" Command="{Binding LoadItemListCommand}">Charger</Button>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <ProgressBar Grid.Row="0"
                                 Classes="sx-quality"
                                 VerticalAlignment="Bottom"
                                 IsVisible="{Binding IsResolvingLocations}"
                                 Maximum="{Binding LocationResolutionTotal}"
                                 Value="{Binding ResolvedLocationCount}"
                                 ToolTip.Tip="Résolution des emplacements en cours" />

                    <!-- Critères de recherche, réservés au mode debug -->
                    <Border Grid.Row="1"
                            IsVisible="{Binding IsInDebugMode}"
                            BorderBrush="{DynamicResource Sx.LineBrush}"
                            BorderThickness="0,0,0,1"
                            Padding="20,12">
                        <Grid ColumnDefinitions="220,*,*" ColumnSpacing="20">
                            <StackPanel Spacing="8">
                                <CheckBox Classes="sx-muted" Content="Utiliser le compte connecté" IsChecked="{Binding UseConnectedProfilAsOwner}" />
                                <TextBlock Classes="sx-caption" Text="Id possesseur" />
                                <comp:NotchedBorder Classes="sx-field" CutSize="9">
                                    <TextBox Classes="sx" Height="36" Text="{Binding OwnerId}" IsEnabled="{Binding !UseConnectedProfilAsOwner}" />
                                </comp:NotchedBorder>
                                <TextBlock Classes="sx-caption" Text="Id objet" />
                                <comp:NotchedBorder Classes="sx-field" CutSize="9">
                                    <TextBox Classes="sx" Height="36" Text="{Binding Id}" />
                                </comp:NotchedBorder>
                            </StackPanel>

                            <Grid Grid.Column="1" RowDefinitions="Auto,*">
                                <Grid ColumnDefinitions="*,Auto">
                                    <TextBlock Classes="sx-caption" Text="Types recherchés" />
                                    <Button Grid.Column="1" Classes="sx-link" Command="{Binding ResetSelectedTypesCommand}">Réinitialiser</Button>
                                </Grid>
                                <ScrollViewer Grid.Row="1" Height="130">
                                    <ItemsControl ItemsSource="{Binding SearchTypeListSorted}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="vm:ItemsTabViewModel+FilterTypeOption">
                                                <CheckBox MinHeight="30" Content="{Binding Type}" IsChecked="{Binding IsSelected}" />
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>
                            </Grid>

                            <Grid Grid.Column="2" RowDefinitions="Auto,*">
                                <Grid ColumnDefinitions="*,Auto,Auto">
                                    <TextBlock Classes="sx-caption" Text="Inventaires" />
                                    <CheckBox Grid.Column="1"
                                              IsThreeState="True"
                                              IsChecked="{Binding SelectAllLocation}"
                                              IsEnabled="{Binding !!LocationList^.Count, FallbackValue=false}" />
                                    <Button Grid.Column="2" Classes="sx-link" Command="{Binding ReloadLocationListCommand}">Rafraîchir</Button>
                                </Grid>
                                <ScrollViewer Grid.Row="1" Height="130">
                                    <ItemsControl ItemsSource="{Binding LocationList^}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="vm:ItemsTabViewModel+FilterLocationOptionModel">
                                                <CheckBox MinHeight="30" Content="{Binding Name^, FallbackValue=Chargement}" IsChecked="{Binding IsSelected}" />
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>
                            </Grid>
                        </Grid>
                    </Border>

                    <!-- Filtres rapides -->
                    <Border Grid.Row="2"
                            IsVisible="{Binding HasLoadedItems}"
                            BorderBrush="{DynamicResource Sx.LineBrush}"
                            BorderThickness="0,0,0,1"
                            Padding="20,12,20,6">
                        <StackPanel>
                            <Grid ColumnDefinitions="72,*">
                                <TextBlock Classes="sx-caption" Text="Type" VerticalAlignment="Top" Margin="0,9,0,0" />
                                <ItemsControl Grid.Column="1" ItemsSource="{Binding TypeChips}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="vm:FilterChipViewModel">
                                            <Button Classes="sx-chip" Classes.on="{Binding IsSelected}" Command="{Binding ToggleCommand}">
                                                <StackPanel Orientation="Horizontal" Spacing="7">
                                                    <TextBlock Text="{Binding Label}" VerticalAlignment="Center" />
                                                    <TextBlock Classes="sx-count" Text="{Binding Count}" />
                                                </StackPanel>
                                            </Button>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </Grid>
                            <Grid ColumnDefinitions="72,*">
                                <TextBlock Classes="sx-caption" Text="Sous-type" VerticalAlignment="Top" Margin="0,9,0,0" />
                                <ItemsControl Grid.Column="1" ItemsSource="{Binding SubTypeChips}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="vm:FilterChipViewModel">
                                            <Button Classes="sx-chip" Classes.on="{Binding IsSelected}" Command="{Binding ToggleCommand}">
                                                <StackPanel Orientation="Horizontal" Spacing="7">
                                                    <TextBlock Text="{Binding Label}" VerticalAlignment="Center" />
                                                    <TextBlock Classes="sx-count" Text="{Binding Count}" />
                                                </StackPanel>
                                            </Button>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- Tableau -->
                    <Grid Grid.Row="3">
                        <DataGrid Classes="sx"
                                  ItemsSource="{Binding DisplayedItems}"
                                  SelectedItem="{Binding SelectedItem}"
                                  IsReadOnly="True"
                                  AutoGenerateColumns="False"
                                  CanUserSortColumns="False"
                                  CanUserReorderColumns="False">
                            <DataGrid.Columns>
                                <DataGridTextColumn Width="34*" Foreground="{DynamicResource Sx.TextBrush}" FontWeight="Medium" Binding="{Binding Name^, FallbackValue=Chargement}">
                                    <DataGridTextColumn.Header>
                                        <comp:ColumnHeader DataContext="{Binding NameColumn}" />
                                    </DataGridTextColumn.Header>
                                </DataGridTextColumn>
                                <DataGridTextColumn Width="18*" Binding="{Binding ItemTypeLabel}">
                                    <DataGridTextColumn.Header>
                                        <comp:ColumnHeader DataContext="{Binding TypeColumn}" />
                                    </DataGridTextColumn.Header>
                                </DataGridTextColumn>
                                <DataGridTextColumn Width="20*" Binding="{Binding Location^, FallbackValue=Chargement}">
                                    <DataGridTextColumn.Header>
                                        <comp:ColumnHeader DataContext="{Binding LocationColumn}" />
                                    </DataGridTextColumn.Header>
                                </DataGridTextColumn>
                                <DataGridTemplateColumn Width="10*">
                                    <DataGridTemplateColumn.Header>
                                        <comp:ColumnHeader Classes="right" DataContext="{Binding QuantityColumn}" />
                                    </DataGridTemplateColumn.Header>
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate x:DataType="models:ItemViewModel">
                                            <TextBlock Classes="sx-mono"
                                                       Foreground="{DynamicResource Sx.TextBrush}"
                                                       HorizontalAlignment="Right"
                                                       Margin="0,0,10,0"
                                                       Text="{Binding StackSize}" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn Width="18*">
                                    <DataGridTemplateColumn.Header>
                                        <comp:ColumnHeader DataContext="{Binding QualityColumn}" />
                                    </DataGridTemplateColumn.Header>
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate x:DataType="models:ItemViewModel">
                                            <Grid Margin="10,0,20,0" VerticalAlignment="Center">
                                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="9" IsVisible="{Binding ContentQuality, Converter={x:Static ObjectConverters.IsNotNull}}">
                                                    <ProgressBar Classes="sx-quality" VerticalAlignment="Center" Value="{Binding ContentQuality}" />
                                                    <TextBlock Grid.Column="1"
                                                               Classes="sx-mono"
                                                               FontSize="12"
                                                               Foreground="{DynamicResource Sx.TextBrush}"
                                                               Text="{Binding ContentQuality}" />
                                                </Grid>
                                                <TextBlock Foreground="{DynamicResource Sx.MutedBrush}"
                                                           IsVisible="{Binding ContentQuality, Converter={x:Static ObjectConverters.IsNull}}"
                                                           Text="—" />
                                            </Grid>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <!-- Colonnes techniques du mode debug -->
                                <DataGridTextColumn Width="160" Header="id" Binding="{Binding Id}" IsVisible="{Binding IsInDebugMode}" />
                                <DataGridTextColumn Width="180" Header="Possesseur" Binding="{Binding Owner^, FallbackValue=Chargement}" IsVisible="{Binding IsInDebugMode}" />
                                <DataGridTextColumn Width="180" Header="Type technique" Binding="{Binding LocalTypeName}" IsVisible="{Binding IsInDebugMode}" />
                                <DataGridTextColumn Width="180" Header="parentUrn" Binding="{Binding ParentUrn}" IsVisible="{Binding IsInDebugMode}" />
                                <DataGridTextColumn Width="120" Header="Possède une entrée Edge" Binding="{Binding Edge, Converter={x:Static ObjectConverters.IsNotNull}}" IsVisible="{Binding IsInDebugMode}" />
                                <DataGridTextColumn Width="120" Header="Location id" Binding="{Binding LocationId}" IsVisible="{Binding IsInDebugMode}" />
                                <DataGridTextColumn Width="140" Header="Location stockage" Binding="{Binding StowLocation}" IsVisible="{Binding IsInDebugMode}" />
                                <DataGridTextColumn Width="140" Header="Location stockage shard" Binding="{Binding StowShard}" IsVisible="{Binding IsInDebugMode}" />
                                <DataGridTextColumn Width="120" Header="EDGE Type" Binding="{Binding EdgeType}" IsVisible="{Binding IsInDebugMode}" />
                                <DataGridTextColumn Width="160" Header="EDGE Location id" Binding="{Binding EdgeLocation}" IsVisible="{Binding IsInDebugMode}" />
                                <DataGridTextColumn Width="140" Header="EDGE AttachmentType" Binding="{Binding EdgeAttachmentType}" IsVisible="{Binding IsInDebugMode}" />
                            </DataGrid.Columns>
                        </DataGrid>

                        <TextBlock Classes="sx-caption"
                                   HorizontalAlignment="Center"
                                   IsVisible="{Binding HasNotLoadedItems}"
                                   Text="Cliquez sur Charger pour récupérer les objets de votre compte." />
                        <TextBlock Classes="sx-caption"
                                   HorizontalAlignment="Center"
                                   IsVisible="{Binding ShowNoMatch}"
                                   Text="Aucun objet ne correspond à ces filtres." />

                        <!-- Indicateur de chargement / filtrage, superposé au tableau -->
                        <Grid IsVisible="{Binding IsBusy}" IsHitTestVisible="False">
                            <Border Background="{DynamicResource Sx.SurfaceBrush}" Opacity="0.75" />
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="10">
                                <ui:ProgressRing IsIndeterminate="True" Width="40" Height="40" HorizontalAlignment="Center" />
                                <TextBlock Classes="sx-caption" HorizontalAlignment="Center" Text="{Binding BusyMessage}" />
                            </StackPanel>
                        </Grid>
                    </Grid>
                </Grid>
            </comp:NotchedBorder>

            <!-- Détail de l'objet sélectionné -->
            <comp:NotchedBorder Grid.Column="2"
                                Margin="0,12,12,12"
                                CutSize="18"
                                Background="{DynamicResource Sx.SurfaceBrush}"
                                Padding="20,22">
                <Panel>
                    <TextBlock Classes="sx-caption"
                               TextWrapping="Wrap"
                               VerticalAlignment="Top"
                               IsVisible="{Binding SelectedItem, Converter={x:Static ObjectConverters.IsNull}}"
                               Text="Sélectionnez un objet pour voir son détail." />
                    <Panel IsVisible="{Binding SelectedItem, Converter={x:Static ObjectConverters.IsNotNull}}" DataContext="{Binding}">
                        <Panel DataContext="{Binding SelectedItem}">
                        <StackPanel x:DataType="models:ItemViewModel">
                            <TextBlock Classes="sx-caption" VerticalAlignment="Top" Text="{Binding ItemTypeLabel}" />
                            <TextBlock FontSize="20"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource Sx.TextBrush}"
                                       TextWrapping="Wrap"
                                       Margin="0,4,0,18"
                                       Text="{Binding Name^, FallbackValue=Chargement}" />

                            <Grid Classes="detail-row" ColumnDefinitions="Auto,*">
                                <TextBlock Classes="sx-caption" VerticalAlignment="Top" Text="Emplacement" />
                                <TextBlock Grid.Column="1" FontSize="13" Text="{Binding Location^, FallbackValue=Chargement}" />
                            </Grid>
                            <Grid Classes="detail-row" ColumnDefinitions="Auto,*">
                                <TextBlock Classes="sx-caption" VerticalAlignment="Top" Text="Quantité" />
                                <TextBlock Grid.Column="1" FontFamily="{DynamicResource Sx.FontMono}" FontSize="13" Text="{Binding StackSize}" />
                            </Grid>
                            <Grid Classes="detail-row" ColumnDefinitions="Auto,*">
                                <TextBlock Classes="sx-caption" VerticalAlignment="Top" Text="Taille occupée" />
                                <TextBlock Grid.Column="1" FontFamily="{DynamicResource Sx.FontMono}" FontSize="13" Text="{Binding EdgeOccupancy, Converter={StaticResource MicroScuConverter}}" />
                            </Grid>
                            <Grid Classes="detail-row" ColumnDefinitions="Auto,*">
                                <TextBlock Classes="sx-caption" VerticalAlignment="Top" Text="Sous-type" />
                                <TextBlock Grid.Column="1" FontSize="13" Text="{Binding ItemSubType}" />
                            </Grid>
                            <Grid Classes="detail-row" ColumnDefinitions="Auto,*">
                                <TextBlock Classes="sx-caption" VerticalAlignment="Top" Text="Qualité du contenu" />
                                <TextBlock Grid.Column="1" FontFamily="{DynamicResource Sx.FontMono}" FontSize="13" Text="{Binding ContentQuality, TargetNullValue='—'}" />
                            </Grid>
                            <Grid Classes="detail-row" ColumnDefinitions="Auto,*">
                                <TextBlock Classes="sx-caption" VerticalAlignment="Top" Text="Quantité du contenu" />
                                <TextBlock Grid.Column="1" FontFamily="{DynamicResource Sx.FontMono}" FontSize="13" Text="{Binding ContentQuantity, Converter={StaticResource MicroScuConverter}}" />
                            </Grid>
                            <Grid Classes="detail-row" ColumnDefinitions="Auto,*">
                                <TextBlock Classes="sx-caption" VerticalAlignment="Top" Text="Identifiant" />
                                <TextBlock Grid.Column="1" FontFamily="{DynamicResource Sx.FontMono}" FontSize="12" Text="{Binding Id}" />
                            </Grid>
                        </StackPanel>
                        </Panel>
                    </Panel>
                </Panel>
            </comp:NotchedBorder>
        </Grid>
    </ThemeVariantScope>
</UserControl>
