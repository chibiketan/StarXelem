<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:StarXelem.ViewModels"
             xmlns:local="clr-namespace:StarXelem"
             xmlns:models="clr-namespace:StarXelem.Models"
             xmlns:comp="clr-namespace:StarXelem.Components"
             xmlns:ui="clr-namespace:FluentAvalonia.UI.Controls;assembly=FluentAvalonia"
             mc:Ignorable="d" d:DesignWidth="1300" d:DesignHeight="800"
             x:DataType="vm:FpsWeaponsTabViewModel"
             d:DataContext="{x:Static local:DesignData.FpsWeaponsTabViewModel}"
             x:Class="StarXelem.Views.FpsWeaponsTabView">
    <UserControl.Styles>
        <Style Selector="Grid.detail-row">
            <Setter Property="Margin" Value="0,0,0,9" />
        </Style>
        <Style Selector="Grid.detail-row > TextBlock:nth-child(1)">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Foreground" Value="{DynamicResource Sx.SecondaryBrush}" />
            <Setter Property="VerticalAlignment" Value="Top" />
        </Style>
        <Style Selector="Grid.detail-row > TextBlock:nth-child(2)">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Foreground" Value="{DynamicResource Sx.TextBrush}" />
            <Setter Property="HorizontalAlignment" Value="Right" />
            <Setter Property="TextAlignment" Value="Right" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Margin" Value="14,0,0,0" />
        </Style>
        <Style Selector="Grid.detail-row.mono > TextBlock:nth-child(2)">
            <Setter Property="FontFamily" Value="{DynamicResource Sx.FontMono}" />
        </Style>
        <!-- Valeurs numériques du tableau : valeur du tir principal, puis celle du tir secondaire en discret -->
        <Style Selector="TextBlock.cell-value">
            <Setter Property="FontFamily" Value="{DynamicResource Sx.FontMono}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Foreground" Value="{DynamicResource Sx.TextBrush}" />
        </Style>
        <Style Selector="TextBlock.cell-secondary">
            <Setter Property="FontFamily" Value="{DynamicResource Sx.FontMono}" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Foreground" Value="{DynamicResource Sx.MutedBrush}" />
        </Style>
    </UserControl.Styles>

    <!-- La nouvelle charte n'existe qu'en thème sombre : l'écran reste sombre même si Windows est en thème clair. -->
    <ThemeVariantScope RequestedThemeVariant="Dark">
        <ThemeVariantScope.Resources>
            <!-- Le tri est géré par comp:ColumnHeader : l'icône native du tableau ne doit pas réserver de place. -->
            <x:Double x:Key="DataGridSortIconMinWidth">0</x:Double>
            <SolidColorBrush x:Key="CheckBoxCheckBackgroundFillChecked" Color="#FFE8B04A" />
            <SolidColorBrush x:Key="CheckBoxCheckBackgroundFillCheckedPointerOver" Color="#D9E8B04A" />
            <SolidColorBrush x:Key="CheckBoxCheckBackgroundFillCheckedPressed" Color="#D9E8B04A" />
            <SolidColorBrush x:Key="CheckBoxCheckBackgroundStrokeChecked" Color="#FFE8B04A" />
            <SolidColorBrush x:Key="CheckBoxCheckBackgroundStrokeCheckedPointerOver" Color="#D9E8B04A" />
            <SolidColorBrush x:Key="CheckBoxCheckBackgroundStrokeCheckedPressed" Color="#D9E8B04A" />
            <SolidColorBrush x:Key="CheckBoxCheckGlyphForegroundChecked" Color="#FF0B0D12" />
            <SolidColorBrush x:Key="CheckBoxCheckGlyphForegroundCheckedPointerOver" Color="#FF0B0D12" />
            <SolidColorBrush x:Key="CheckBoxCheckGlyphForegroundCheckedPressed" Color="#FF0B0D12" />
            <!-- Curseurs de plage aux couleurs de l'accent -->
            <SolidColorBrush x:Key="SliderTrackValueFill" Color="#FFE8B04A" />
            <SolidColorBrush x:Key="SliderTrackValueFillPointerOver" Color="#D9E8B04A" />
            <SolidColorBrush x:Key="SliderTrackValueFillPressed" Color="#D9E8B04A" />
            <SolidColorBrush x:Key="SliderThumbBackground" Color="#FFE8B04A" />
            <SolidColorBrush x:Key="SliderThumbBackgroundPointerOver" Color="#FFE8B04A" />
            <SolidColorBrush x:Key="SliderThumbBackgroundPressed" Color="#D9E8B04A" />
            <SolidColorBrush x:Key="SliderTrackFill" Color="#FF2A2F3A" />
            <SolidColorBrush x:Key="SliderTrackFillPointerOver" Color="#FF2A2F3A" />
            <SolidColorBrush x:Key="SliderTrackFillPressed" Color="#FF2A2F3A" />
        </ThemeVariantScope.Resources>

        <Grid Background="{DynamicResource Sx.BackgroundBrush}"
              ColumnDefinitions="*,12,300"
              TextElement.FontFamily="{DynamicResource Sx.FontSans}">

            <!-- Bloc principal -->
            <comp:NotchedBorder Grid.Column="0" Margin="12,12,0,12" CutSize="18" Background="{DynamicResource Sx.SurfaceBrush}">
                <Grid RowDefinitions="Auto,Auto,Auto,*">

                    <!-- Barre d'outils -->
                    <Border Grid.Row="0" BorderBrush="{DynamicResource Sx.LineBrush}" BorderThickness="0,0,0,1" Padding="20,14">
                        <Grid ColumnDefinitions="Auto,Auto,*,Auto" ColumnSpacing="12">
                            <TextBlock Classes="sx-title" Text="Armes FPS" Margin="0,0,8,0" />
                            <TextBlock Grid.Column="1" Classes="sx-caption" FontSize="13" Text="{Binding ResultSummary}" />

                            <comp:NotchedBorder Grid.Column="2" Classes="sx-field" MinWidth="180">
                                <Grid ColumnDefinitions="Auto,*">
                                    <Path Classes="sx-search-icon" Margin="12,0,0,0" />
                                    <TextBox Grid.Column="1"
                                             Classes="sx"
                                             Height="44"
                                             Watermark="Nom de l'arme, fabricant, livrée..."
                                             Text="{Binding NameFilter}" />
                                </Grid>
                            </comp:NotchedBorder>

                            <Button Grid.Column="3"
                                    Classes="sx"
                                    Classes.on="{Binding IsRangePanelOpen}"
                                    ToolTip.Tip="Filtrer par plage de dégâts et de portée"
                                    Command="{Binding ToggleRangePanelCommand}"
                                    Content="{Binding RangeButtonLabel}" />
                        </Grid>
                    </Border>

                    <!-- Filtres rapides -->
                    <Border Grid.Row="1"
                            BorderBrush="{DynamicResource Sx.LineBrush}"
                            BorderThickness="0,0,0,1"
                            Padding="20,12,20,6">
                        <StackPanel>
                            <Grid ColumnDefinitions="72,*">
                                <TextBlock Classes="sx-caption" Text="Classe" VerticalAlignment="Top" Margin="0,9,0,0" />
                                <ItemsControl Grid.Column="1" ItemsSource="{Binding ClassChips}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="vm:FilterChipViewModel">
                                            <Button Classes="sx-chip" Classes.on="{Binding IsSelected}" Command="{Binding ToggleCommand}">
                                                <StackPanel Orientation="Horizontal" Spacing="7">
                                                    <TextBlock Text="{Binding Label}" VerticalAlignment="Center" />
                                                    <TextBlock Classes="sx-count" Text="{Binding Count}" />
                                                </StackPanel>
                                            </Button>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </Grid>
                            <Grid ColumnDefinitions="72,*">
                                <TextBlock Classes="sx-caption" Text="Dégâts" VerticalAlignment="Top" Margin="0,9,0,0" />
                                <ItemsControl Grid.Column="1" ItemsSource="{Binding DamageTypeChips}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="vm:FilterChipViewModel">
                                            <Button Classes="sx-chip" Classes.on="{Binding IsSelected}" Command="{Binding ToggleCommand}">
                                                <StackPanel Orientation="Horizontal" Spacing="7">
                                                    <TextBlock Text="{Binding Label}" VerticalAlignment="Center" />
                                                    <TextBlock Classes="sx-count" Text="{Binding Count}" />
                                                </StackPanel>
                                            </Button>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- Plages de dégâts et de portée, repliées par défaut -->
                    <Border Grid.Row="2"
                            IsVisible="{Binding IsRangePanelOpen}"
                            BorderBrush="{DynamicResource Sx.LineBrush}"
                            BorderThickness="0,0,0,1"
                            Padding="20,12">
                        <Grid ColumnDefinitions="*,*,Auto" ColumnSpacing="28">
                            <StackPanel Spacing="2">
                                <TextBlock Classes="sx-caption" Text="Dégâts par tir" />
                                <Grid ColumnDefinitions="44,*">
                                    <TextBlock Classes="sx-mono" FontSize="12" Foreground="{DynamicResource Sx.TextBrush}" Text="{Binding DamageMin, StringFormat='{}{0:0}'}" />
                                    <Slider Grid.Column="1"
                                            Minimum="{Binding DamageLowerBound}"
                                            Maximum="{Binding DamageUpperBound}"
                                            Value="{Binding DamageMin, Mode=TwoWay}"
                                            TickFrequency="1" IsSnapToTickEnabled="True" />
                                </Grid>
                                <Grid ColumnDefinitions="44,*">
                                    <TextBlock Classes="sx-mono" FontSize="12" Foreground="{DynamicResource Sx.TextBrush}" Text="{Binding DamageMax, StringFormat='{}{0:0}'}" />
                                    <Slider Grid.Column="1"
                                            Minimum="{Binding DamageLowerBound}"
                                            Maximum="{Binding DamageUpperBound}"
                                            Value="{Binding DamageMax, Mode=TwoWay}"
                                            TickFrequency="1" IsSnapToTickEnabled="True" />
                                </Grid>
                            </StackPanel>

                            <StackPanel Grid.Column="1" Spacing="2">
                                <TextBlock Classes="sx-caption" Text="Portée de dégâts pleins (m)" />
                                <Grid ColumnDefinitions="44,*">
                                    <TextBlock Classes="sx-mono" FontSize="12" Foreground="{DynamicResource Sx.TextBrush}" Text="{Binding EffectiveRangeMin, StringFormat='{}{0:0}'}" />
                                    <Slider Grid.Column="1"
                                            Minimum="{Binding EffectiveRangeLowerBound}"
                                            Maximum="{Binding EffectiveRangeUpperBound}"
                                            Value="{Binding EffectiveRangeMin, Mode=TwoWay}"
                                            TickFrequency="1" IsSnapToTickEnabled="True" />
                                </Grid>
                                <Grid ColumnDefinitions="44,*">
                                    <TextBlock Classes="sx-mono" FontSize="12" Foreground="{DynamicResource Sx.TextBrush}" Text="{Binding EffectiveRangeMax, StringFormat='{}{0:0}'}" />
                                    <Slider Grid.Column="1"
                                            Minimum="{Binding EffectiveRangeLowerBound}"
                                            Maximum="{Binding EffectiveRangeUpperBound}"
                                            Value="{Binding EffectiveRangeMax, Mode=TwoWay}"
                                            TickFrequency="1" IsSnapToTickEnabled="True" />
                                </Grid>
                                <CheckBox Classes="sx-muted"
                                          Content="Inclure les armes sans portée connue"
                                          IsChecked="{Binding IncludeWeaponsWithoutEffectiveRange, Mode=TwoWay}" />
                            </StackPanel>

                            <Button Grid.Column="2" Classes="sx-link" VerticalAlignment="Top" Command="{Binding ResetRangesCommand}">Réinitialiser</Button>
                        </Grid>
                    </Border>

                    <!-- Tableau -->
                    <Grid Grid.Row="3">
                        <DataGrid Classes="sx"
                                  ItemsSource="{Binding Weapons}"
                                  SelectedItem="{Binding SelectedWeapon, Mode=TwoWay}"
                                  IsReadOnly="True"
                                  AutoGenerateColumns="False"
                                  CanUserSortColumns="False"
                                  CanUserReorderColumns="False">
                            <DataGrid.Columns>
                                <DataGridTemplateColumn Width="27*">
                                    <DataGridTemplateColumn.Header>
                                        <comp:ColumnHeader DataContext="{Binding NameColumn}" />
                                    </DataGridTemplateColumn.Header>
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate x:DataType="models:FpsWeaponModel">
                                            <StackPanel Margin="12,5,10,5" VerticalAlignment="Center">
                                                <TextBlock FontSize="14"
                                                           FontWeight="Medium"
                                                           Foreground="{DynamicResource Sx.TextBrush}"
                                                           TextTrimming="CharacterEllipsis"
                                                           Text="{Binding Name}" />
                                                <TextBlock Classes="sx-mono"
                                                           FontSize="11"
                                                           Foreground="{DynamicResource Sx.SecondaryBrush}"
                                                           TextTrimming="CharacterEllipsis"
                                                           Text="{Binding TechnicalName}" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <DataGridTemplateColumn Width="18*">
                                    <DataGridTemplateColumn.Header>
                                        <comp:ColumnHeader DataContext="{Binding ClassColumn}" />
                                    </DataGridTemplateColumn.Header>
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate x:DataType="models:FpsWeaponModel">
                                            <TextBlock Margin="12,0,10,0" FontSize="13" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Text="{Binding WeaponClassLabel}" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <DataGridTemplateColumn Width="15*">
                                    <DataGridTemplateColumn.Header>
                                        <comp:ColumnHeader DataContext="{Binding ManufacturerColumn}" />
                                    </DataGridTemplateColumn.Header>
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate x:DataType="models:FpsWeaponModel">
                                            <TextBlock Margin="12,0,10,0" FontSize="13" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Text="{Binding Manufacturer, TargetNullValue='—'}" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <DataGridTemplateColumn Width="9*">
                                    <DataGridTemplateColumn.Header>
                                        <comp:ColumnHeader DataContext="{Binding MagazineColumn}" />
                                    </DataGridTemplateColumn.Header>
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate x:DataType="models:FpsWeaponModel">
                                            <TextBlock Classes="cell-value" Margin="12,0,10,0" VerticalAlignment="Center" Text="{Binding MagazineSizeDisplay}" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <DataGridTemplateColumn Width="10*">
                                    <DataGridTemplateColumn.Header>
                                        <comp:ColumnHeader DataContext="{Binding DamageColumn}" />
                                    </DataGridTemplateColumn.Header>
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate x:DataType="models:FpsWeaponModel">
                                            <StackPanel Margin="12,0,10,0" VerticalAlignment="Center">
                                                <StackPanel Orientation="Horizontal" Spacing="4">
                                                    <TextBlock Classes="cell-value" Text="{Binding PrimaryDamageDisplay}" />
                                                    <TextBlock Classes="cell-secondary" VerticalAlignment="Center" Text="{Binding PrimaryPelletDisplay}" />
                                                </StackPanel>
                                                <StackPanel Orientation="Horizontal" Spacing="4" IsVisible="{Binding HasSecondaryFire}" ToolTip.Tip="Tir secondaire">
                                                    <TextBlock Classes="cell-secondary" Text="{Binding SecondaryDamageDisplay}" />
                                                    <TextBlock Classes="cell-secondary" Text="{Binding SecondaryPelletDisplay}" />
                                                </StackPanel>
                                            </StackPanel>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <DataGridTemplateColumn Width="9*">
                                    <DataGridTemplateColumn.Header>
                                        <comp:ColumnHeader DataContext="{Binding FireRateColumn}" />
                                    </DataGridTemplateColumn.Header>
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate x:DataType="models:FpsWeaponModel">
                                            <StackPanel Margin="12,0,10,0" VerticalAlignment="Center">
                                                <TextBlock Classes="cell-value" Text="{Binding PrimaryFireRateDisplay}" />
                                                <TextBlock Classes="cell-secondary" IsVisible="{Binding HasSecondaryFire}" ToolTip.Tip="Tir secondaire" Text="{Binding SecondaryFireRateDisplay}" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <DataGridTemplateColumn Width="12*">
                                    <DataGridTemplateColumn.Header>
                                        <comp:ColumnHeader DataContext="{Binding MaxRangeColumn}" />
                                    </DataGridTemplateColumn.Header>
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate x:DataType="models:FpsWeaponModel">
                                            <StackPanel Margin="12,0,10,0" VerticalAlignment="Center">
                                                <TextBlock Classes="cell-value" Text="{Binding PrimaryMaxRangeDisplay}" />
                                                <TextBlock Classes="cell-secondary" IsVisible="{Binding HasSecondaryFire}" ToolTip.Tip="Tir secondaire" Text="{Binding SecondaryMaxRangeDisplay}" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>

                        <TextBlock Classes="sx-caption"
                                   HorizontalAlignment="Center"
                                   IsVisible="{Binding ShowNoMatch}"
                                   Text="Aucune arme ne correspond à ces filtres." />

                        <!-- Indicateur de chargement / filtrage, superposé au tableau -->
                        <Grid IsVisible="{Binding IsBusy}" IsHitTestVisible="False">
                            <Border Background="{DynamicResource Sx.SurfaceBrush}" Opacity="0.75" />
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="10">
                                <ui:ProgressRing IsIndeterminate="True" Width="40" Height="40" HorizontalAlignment="Center" />
                                <TextBlock Classes="sx-caption" HorizontalAlignment="Center" Text="{Binding BusyMessage}" />
                            </StackPanel>
                        </Grid>
                    </Grid>
                </Grid>
            </comp:NotchedBorder>

            <!-- Détail de l'arme sélectionnée -->
            <comp:NotchedBorder Grid.Column="2"
                                Margin="0,12,12,12"
                                CutSize="18"
                                Background="{DynamicResource Sx.SurfaceBrush}"
                                Padding="20,22">
                <Panel>
                    <TextBlock Classes="sx-caption"
                               TextWrapping="Wrap"
                               VerticalAlignment="Top"
                               IsVisible="{Binding !HasSelectedWeapon}"
                               Text="Sélectionnez une arme pour voir son détail." />
                    <Panel IsVisible="{Binding HasSelectedWeapon}">
                        <Panel DataContext="{Binding SelectedWeapon}">
                        <Grid x:DataType="models:FpsWeaponModel" RowDefinitions="Auto,*">
                            <StackPanel Grid.Row="0">
                                <TextBlock Classes="sx-caption" VerticalAlignment="Top" TextWrapping="Wrap" Text="{Binding ClassAndManufacturer}" />
                                <TextBlock FontSize="22"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource Sx.TextBrush}"
                                           TextWrapping="Wrap"
                                           Margin="0,4,0,16"
                                           Text="{Binding Name}" />

                                <Grid Classes="detail-row" ColumnDefinitions="Auto,*">
                                    <TextBlock Text="Mode" />
                                    <TextBlock Grid.Column="1" Text="{Binding PrimaryModeDisplay}" />
                                </Grid>
                                <Grid Classes="detail-row" ColumnDefinitions="Auto,*">
                                    <TextBlock Text="Type de dégâts" />
                                    <TextBlock Grid.Column="1" Text="{Binding PrimaryDamageTypeLabel}" />
                                </Grid>
                                <Grid Classes="detail-row mono" ColumnDefinitions="Auto,*">
                                    <TextBlock Text="Vitesse projectile" />
                                    <TextBlock Grid.Column="1" Text="{Binding PrimaryProjectileSpeedDisplay}" />
                                </Grid>
                                <Grid Classes="detail-row mono" ColumnDefinitions="Auto,*">
                                    <TextBlock Text="Portée dégâts pleins" />
                                    <TextBlock Grid.Column="1" Text="{Binding PrimaryEffectiveRangeDisplay}" />
                                </Grid>
                                <Grid Classes="detail-row mono" ColumnDefinitions="Auto,*">
                                    <TextBlock Text="Extraction sac à dos" />
                                    <TextBlock Grid.Column="1" Text="{Binding RepoolDisplay}" />
                                </Grid>

                                <!-- Tir secondaire, pour les armes qui en ont un -->
                                <Border IsVisible="{Binding HasSecondaryFire}"
                                        BorderBrush="{DynamicResource Sx.LineBrush}"
                                        BorderThickness="0,1,0,0"
                                        Margin="0,9,0,0"
                                        Padding="0,14,0,0">
                                    <StackPanel>
                                        <TextBlock FontWeight="SemiBold" Foreground="{DynamicResource Sx.TextBrush}" Margin="0,0,0,10" Text="Tir secondaire" />
                                        <Grid Classes="detail-row" ColumnDefinitions="Auto,*">
                                            <TextBlock Text="Mode" />
                                            <TextBlock Grid.Column="1" Text="{Binding SecondaryModeDisplay}" />
                                        </Grid>
                                        <Grid Classes="detail-row" ColumnDefinitions="Auto,*">
                                            <TextBlock Text="Type de dégâts" />
                                            <TextBlock Grid.Column="1" Text="{Binding SecondaryDamageTypeLabel}" />
                                        </Grid>
                                        <Grid Classes="detail-row mono" ColumnDefinitions="Auto,*">
                                            <TextBlock Text="Vitesse projectile" />
                                            <TextBlock Grid.Column="1" Text="{Binding SecondaryProjectileSpeedDisplay}" />
                                        </Grid>
                                        <Grid Classes="detail-row mono" ColumnDefinitions="Auto,*">
                                            <TextBlock Text="Portée dégâts pleins" />
                                            <TextBlock Grid.Column="1" Text="{Binding SecondaryEffectiveRangeDisplay}" />
                                        </Grid>
                                    </StackPanel>
                                </Border>

                                <TextBlock FontWeight="SemiBold"
                                           Foreground="{DynamicResource Sx.TextBrush}"
                                           Margin="0,9,0,8"
                                           Text="{Binding VariantHeader}" />
                            </StackPanel>

                            <!-- Livrées : la séparation est portée par le haut de la liste -->
                            <Border Grid.Row="1" BorderBrush="{DynamicResource Sx.LineBrush}" BorderThickness="0,1,0,0" Padding="0,6,0,0">
                                <ScrollViewer>
                                    <ItemsControl ItemsSource="{Binding VariantNameList}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="x:String">
                                                <TextBlock Margin="0,4"
                                                           FontSize="13"
                                                           Foreground="{DynamicResource Sx.SecondaryBrush}"
                                                           TextWrapping="Wrap"
                                                           Text="{Binding}" />
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>
                            </Border>
                        </Grid>
                        </Panel>
                    </Panel>
                </Panel>
            </comp:NotchedBorder>
        </Grid>
    </ThemeVariantScope>
</UserControl>
