<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:StarXelem.ViewModels"
             xmlns:local="clr-namespace:StarXelem"
             xmlns:conv="clr-namespace:StarXelem.Converters"
             xmlns:comp="clr-namespace:StarXelem.Components"
             xmlns:ui="clr-namespace:FluentAvalonia.UI.Controls;assembly=FluentAvalonia"
             mc:Ignorable="d"
             x:Class="StarXelem.Views.MissionsTabView"
             x:DataType="vm:MissionsTabViewModel"
             d:DesignHeight="800"
             d:DesignWidth="1424"
             d:DataContext="{x:Static local:DesignData.MissionsTabViewModel}">
    <UserControl.Styles>
        <!-- Listes (catégories, missions) : lignes à angles coupés, sélection en accent doux -->
        <Style Selector="ListBox.sx-list">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
        </Style>
        <Style Selector="ListBox.sx-list ListBoxItem">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource Sx.TextBrush}" />
            <Setter Property="Padding" Value="12,9" />
            <Setter Property="Margin" Value="0,0,0,2" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <ControlTemplate TargetType="ListBoxItem">
                    <comp:NotchedBorder CutSize="9" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                        <ContentPresenter Content="{TemplateBinding Content}"
                                          ContentTemplate="{TemplateBinding ContentTemplate}"
                                          HorizontalContentAlignment="Stretch" />
                    </comp:NotchedBorder>
                </ControlTemplate>
            </Setter>
        </Style>
        <Style Selector="ListBox.sx-list ListBoxItem:pointerover">
            <Setter Property="Background" Value="{DynamicResource Sx.ReliefBrush}" />
        </Style>
        <Style Selector="ListBox.sx-list ListBoxItem:selected">
            <Setter Property="Background" Value="{DynamicResource Sx.AccentSoftBrush}" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style Selector="TextBlock.contractor">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="Normal" />
            <Setter Property="Foreground" Value="{DynamicResource Sx.SecondaryBrush}" />
        </Style>

        <!-- Détail -->
        <Style Selector="TextBlock.section-title">
            <Setter Property="FontSize" Value="16" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource Sx.TextBrush}" />
            <Setter Property="Margin" Value="0,0,0,10" />
        </Style>
        <Style Selector="TextBlock.body">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="LineHeight" Value="21" />
            <Setter Property="Foreground" Value="{DynamicResource Sx.SecondaryBrush}" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <Style Selector="comp|NotchedBorder.reward-card">
            <Setter Property="CutSize" Value="14" />
            <Setter Property="Padding" Value="16,14" />
            <Setter Property="Margin" Value="0,0,10,10" />
            <Setter Property="Background" Value="{DynamicResource Sx.ReliefBrush}" />
        </Style>
        <Style Selector="TextBlock.meta-label">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{DynamicResource Sx.SecondaryBrush}" />
        </Style>
        <Style Selector="TextBlock.meta-value">
            <Setter Property="FontFamily" Value="{DynamicResource Sx.FontMono}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Foreground" Value="{DynamicResource Sx.TextBrush}" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
    </UserControl.Styles>

    <!-- La nouvelle charte n'existe qu'en thème sombre : l'écran reste sombre même si Windows est en thème clair. -->
    <ThemeVariantScope RequestedThemeVariant="Dark">
        <Grid Background="{DynamicResource Sx.BackgroundBrush}" TextElement.FontFamily="{DynamicResource Sx.FontSans}">
        <Grid ColumnDefinitions="210,280,*" ColumnSpacing="12" Margin="12">

            <!-- Catégories -->
            <comp:NotchedBorder CutSize="18" Background="{DynamicResource Sx.SurfaceBrush}" Padding="12,18,12,12">
                <Grid RowDefinitions="Auto,*" RowSpacing="10">
                    <Grid ColumnDefinitions="*,Auto" Margin="12,0,0,0">
                        <TextBlock Classes="sx-title" Text="Missions" VerticalAlignment="Center" />
                        <Button Grid.Column="1"
                                Classes="sx small"
                                Command="{Binding RefreshCommand}"
                                ToolTip.Tip="Recharger les missions depuis la base locale"
                                Content="Rafraîchir" />
                    </Grid>
                    <ListBox Grid.Row="1" Classes="sx-list" ItemsSource="{Binding CategoryList}" SelectedItem="{Binding SelectedCategory}">
                        <ListBox.ItemTemplate>
                            <DataTemplate x:DataType="vm:MissionCategoryItemViewModel">
                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8" Background="Transparent">
                                    <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Name}" />
                                    <TextBlock Grid.Column="1" Classes="sx-count" Text="{Binding Count}" />
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </comp:NotchedBorder>

            <!-- Missions de la catégorie -->
            <comp:NotchedBorder Grid.Column="1" CutSize="18" Background="{DynamicResource Sx.SurfaceBrush}" Padding="12,18,12,12">
                <Grid RowDefinitions="Auto,Auto,*" RowSpacing="10">
                    <comp:NotchedBorder Classes="sx-field">
                        <Grid ColumnDefinitions="Auto,*">
                            <Path Classes="sx-search-icon" Margin="12,0,0,0" />
                            <TextBox Grid.Column="1"
                                     Classes="sx"
                                     Height="44"
                                     Watermark="Rechercher une mission..."
                                     Text="{Binding Search}" />
                        </Grid>
                    </comp:NotchedBorder>

                    <TextBlock Grid.Row="1" Classes="sx-caption" Margin="12,0">
                        <Run Text="{Binding FilteredMissionList.Count}" />
                        <Run Text="missions" />
                    </TextBlock>

                    <Grid Grid.Row="2">
                        <ListBox Classes="sx-list" ItemsSource="{Binding FilteredMissionList}" SelectedItem="{Binding SelectedMission}">
                            <ListBox.ItemTemplate>
                                <DataTemplate x:DataType="vm:MissionItemViewModel">
                                    <StackPanel Background="Transparent" ToolTip.Tip="{Binding DebugName}">
                                        <TextBlock Classes="contractor" Text="{Binding Contractor.Name}" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>

                        <TextBlock Classes="sx-caption"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   TextWrapping="Wrap"
                                   TextAlignment="Center"
                                   IsVisible="{Binding ShowNoMatch}"
                                   Text="Aucune mission ne correspond à cette recherche." />

                        <!-- Indicateur de chargement / filtrage, superposé à la liste -->
                        <Grid IsVisible="{Binding IsBusy}" IsHitTestVisible="False">
                            <Border Background="{DynamicResource Sx.SurfaceBrush}" Opacity="0.75" />
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="10" Margin="12,0">
                                <ui:ProgressRing IsIndeterminate="True" Width="40" Height="40" HorizontalAlignment="Center" />
                                <TextBlock Classes="sx-caption" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" Text="{Binding BusyMessage}" />
                            </StackPanel>
                        </Grid>
                    </Grid>
                </Grid>
            </comp:NotchedBorder>

            <!-- Détail de la mission sélectionnée -->
            <comp:NotchedBorder Grid.Column="2" CutSize="18" Background="{DynamicResource Sx.SurfaceBrush}">
                <Grid>
                    <TextBlock Classes="sx-caption"
                               FontSize="13"
                               Margin="28,26"
                               IsVisible="{Binding !HasSelection}"
                               Text="Sélectionnez une mission dans la liste pour afficher son détail." />

                    <ScrollViewer VerticalScrollBarVisibility="Auto" IsVisible="{Binding HasSelection}">
                        <StackPanel Margin="28,26" Spacing="22">
                            <!-- En-tête : contractant et titre -->
                            <StackPanel Spacing="4">
                                <TextBlock FontSize="13" Foreground="{DynamicResource Sx.SecondaryBrush}" Text="{Binding SelectedMission.Contractor.Name, FallbackValue=''}" />
                                <TextBlock FontSize="30"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource Sx.TextBrush}"
                                           TextWrapping="Wrap"
                                           Text="{Binding SelectedMission.Title, FallbackValue=''}" />
                            </StackPanel>

                            <!-- Récompenses : une carte par récompense, colonnes de 150 px minimum -->
                            <StackPanel IsVisible="{Binding SelectedMission.HasRewards, FallbackValue=False}">
                                <TextBlock Classes="section-title" Text="Récompenses" />
                                <ItemsControl ItemsSource="{Binding SelectedMission.RewardCards, FallbackValue={x:Null}}" Margin="0,0,-10,-10">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <UniformGrid Columns="{Binding $parent[ItemsControl].Bounds.Width, Converter={x:Static conv:WidthToColumnsConverter.Instance}, ConverterParameter=170}" />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="vm:MissionRewardCardViewModel">
                                            <comp:NotchedBorder Classes="reward-card" ToolTip.Tip="{Binding ToolTip}">
                                                <StackPanel Spacing="2">
                                                    <TextBlock FontFamily="{DynamicResource Sx.FontMono}"
                                                               FontSize="22"
                                                               FontWeight="Medium"
                                                               Foreground="{DynamicResource Sx.TextBrush}"
                                                               TextTrimming="CharacterEllipsis"
                                                               IsVisible="{Binding HasValue}"
                                                               Text="{Binding Value}" />
                                                    <TextBlock FontSize="13"
                                                               Foreground="{DynamicResource Sx.SecondaryBrush}"
                                                               TextWrapping="Wrap"
                                                               Text="{Binding Label}" />
                                                    <TextBlock FontSize="12"
                                                               Foreground="{DynamicResource Sx.MutedBrush}"
                                                               TextWrapping="Wrap"
                                                               IsVisible="{Binding HasDetail}"
                                                               Text="{Binding Detail}" />
                                                </StackPanel>
                                            </comp:NotchedBorder>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>

                            <!-- Objectifs numérotés, sous-objectifs en retrait -->
                            <StackPanel IsVisible="{Binding SelectedMission.HasObjectives, FallbackValue=False}">
                                <TextBlock Classes="section-title" Text="Objectifs" Margin="0,0,0,6" />
                                <ItemsControl ItemsSource="{Binding SelectedMission.ObjectiveList, FallbackValue={x:Null}}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="vm:MissionObjectiveViewModel">
                                            <StackPanel>
                                                <Grid ColumnDefinitions="22,*" MinHeight="26">
                                                    <TextBlock Classes="body" FontFamily="{DynamicResource Sx.FontMono}" Text="{Binding Number}" VerticalAlignment="Center" />
                                                    <TextBlock Grid.Column="1" Classes="body" Text="{Binding Title}" VerticalAlignment="Center" />
                                                </Grid>
                                                <ItemsControl ItemsSource="{Binding ObjectiveList}" Margin="22,0,0,0">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate x:DataType="vm:MissionObjectiveViewModel">
                                                            <Grid ColumnDefinitions="16,*" MinHeight="24">
                                                                <TextBlock Classes="body" Foreground="{DynamicResource Sx.MutedBrush}" Text="–" VerticalAlignment="Center" />
                                                                <TextBlock Grid.Column="1" Classes="body" Text="{Binding Title}" VerticalAlignment="Center" />
                                                            </Grid>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </StackPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>

                            <!-- Briefing -->
                            <StackPanel IsVisible="{Binding SelectedMission.HasBriefing, FallbackValue=False}">
                                <TextBlock Classes="section-title" Text="Briefing" Margin="0,0,0,8" />
                                <TextBlock Classes="body" MaxWidth="640" HorizontalAlignment="Left" Text="{Binding SelectedMission.Briefing, FallbackValue=''}" />
                            </StackPanel>

                            <!-- Prérequis -->
                            <StackPanel IsVisible="{Binding SelectedMission.HasPrerequisites, FallbackValue=False}">
                                <TextBlock Classes="section-title" Text="Prérequis" Margin="0,0,0,6" />
                                <ItemsControl ItemsSource="{Binding SelectedMission.PrerequisiteList, FallbackValue={x:Null}}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="vm:MissionPrerequisiteViewModel">
                                            <Grid ColumnDefinitions="16,*" MinHeight="24">
                                                <TextBlock Classes="body" Foreground="{DynamicResource Sx.MutedBrush}" Text="–" VerticalAlignment="Center" />
                                                <TextBlock Grid.Column="1" Classes="body" Text="{Binding Label}" VerticalAlignment="Center" />
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>

                            <!-- Informations techniques -->
                            <Border BorderBrush="{DynamicResource Sx.LineBrush}" BorderThickness="0,1,0,0" Padding="0,14,0,0">
                                <WrapPanel>
                                    <StackPanel Margin="0,0,32,8" IsVisible="{Binding SelectedMission.HasMaxStanding, FallbackValue=False}">
                                        <TextBlock Classes="meta-label" Text="Réputation maximale" />
                                        <TextBlock Classes="meta-value" Text="{Binding SelectedMission.MaxStanding, FallbackValue=''}" />
                                    </StackPanel>
                                    <StackPanel Margin="0,0,32,8">
                                        <TextBlock Classes="meta-label" Text="Nom technique" />
                                        <SelectableTextBlock FontFamily="{DynamicResource Sx.FontMono}" FontSize="13" Foreground="{DynamicResource Sx.TextBrush}" Text="{Binding SelectedMission.DebugName, FallbackValue=''}" />
                                    </StackPanel>
                                    <StackPanel Margin="0,0,32,8" IsVisible="{Binding SelectedMission.HasCompletionTags, FallbackValue=False}">
                                        <TextBlock Classes="meta-label" Text="Tags de fin de mission" />
                                        <TextBlock Classes="meta-value" Text="{Binding SelectedMission.CompletionTags, FallbackValue=''}" />
                                    </StackPanel>
                                </WrapPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </comp:NotchedBorder>
        </Grid>
        </Grid>
    </ThemeVariantScope>
</UserControl>
