<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:ic="clr-namespace:FluentIcons.Avalonia.Fluent;assembly=FluentIcons.Avalonia.Fluent"
             xmlns:vm="using:StarXelem.ViewModels"
             xmlns:local="clr-namespace:StarXelem"
             mc:Ignorable="d"
             x:Class="StarXelem.Views.MissionsTabView"
             x:DataType="vm:MissionsTabViewModel"
             d:DesignHeight="600"
             d:DesignWidth="1424"
             d:DataContext="{x:Static local:DesignData.MissionsTabViewModel}">
  <Grid RowDefinitions="Auto,*" ColumnDefinitions="200,200,*" Margin="8">
    <StackPanel Orientation="Horizontal" Spacing="8">
      <Button Content="Rafraîchir" Command="{Binding RefreshCommand}"/>
      <TextBlock Text="Chargement..." IsVisible="{Binding IsLoading}" VerticalAlignment="Center"/>
    </StackPanel>
      <ListBox Grid.Row="1" Grid.Column="0" ItemsSource="{Binding ContractorList}" SelectedItem="{Binding SelectedContractor}">
          <ListBox.ItemTemplate>
              <DataTemplate DataType="vm:MissionContractorItemViewModel">
                  <StackPanel>
                      <TextBlock Text="{Binding Name}" FontWeight="SemiBold"/>
                  </StackPanel>
              </DataTemplate>
          </ListBox.ItemTemplate>
      </ListBox>
      <ListBox Grid.Row="1" Grid.Column="1" ItemsSource="{Binding SelectedContractor.MissionList}" SelectedItem="{Binding SelectedMission}">
          <ListBox.ItemTemplate>
              <DataTemplate DataType="vm:MissionItemViewModel">
                  <StackPanel>
                      <TextBlock Text="{Binding Title}" FontWeight="SemiBold"/>
                  </StackPanel>
              </DataTemplate>
          </ListBox.ItemTemplate>
      </ListBox>
      <Grid Grid.Row="1" Grid.Column="2" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,*" ColumnDefinitions="100,*,100,*" IsVisible="{Binding SelectedMission, 
                            Converter={x:Static ObjectConverters.IsNotNull}}">
          <TextBlock Grid.Row="0" Grid.Column="0" FontWeight="Bold">Titre :</TextBlock>
          <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding SelectedMission.Title}" TextWrapping="Wrap" />
          <TextBlock Grid.Row="0" Grid.Column="2" FontWeight="Bold">Récompenses :</TextBlock>
          <ItemsControl Grid.Row="0" Grid.Column="3" Grid.RowSpan="2" ItemsSource="{Binding SelectedMission.RewardList}">
              <ItemsControl.ItemTemplate>
                  <DataTemplate DataType="vm:MissionRewardItemViewModel">
                      <WrapPanel Margin="0, 0, 0, 5">
                          <TextBlock Text="{Binding Count}" Width="40" TextAlignment="Right" Margin="0,0,5,0" />
                          <TextBlock Text="{Binding Name}" />
                          <ic:SymbolIcon Symbol="Home" Margin="5, 0, 0,0" Foreground="Orange" >
                              <ic:SymbolIcon.IsVisible>
                                  <MultiBinding Converter="{x:Static BoolConverters.And}">
                                      <Binding Path="SendToHomeLocation" Converter="{x:Static ObjectConverters.IsNotNull}" />
                                      <Binding Path="SendToHomeLocation" />
                                  </MultiBinding>
                              </ic:SymbolIcon.IsVisible>
                          </ic:SymbolIcon>
                          <ic:SymbolIcon Symbol="Backpack" Margin="5, 0, 0,0" Foreground="Green">
                              <ic:SymbolIcon.IsVisible>
                                  <MultiBinding Converter="{x:Static BoolConverters.And}">
                                      <Binding Path="SendToHomeLocation" Converter="{x:Static ObjectConverters.IsNotNull}" />
                                      <Binding Path="!SendToHomeLocation" />
                                  </MultiBinding>
                              </ic:SymbolIcon.IsVisible>
                              
                          </ic:SymbolIcon>
                          <ic:SymbolIcon Symbol="PeopleTeamDelete" IsVisible="{Binding OnlyToMissionOwner}" Margin="5, 0, 0,0" Foreground="Red"/>
                          <ic:SymbolIcon Symbol="PeopleTeam" IsVisible="{Binding !OnlyToMissionOwner}" Margin="5, 0, 0,0" Foreground="Green" />
                      </WrapPanel>
                  </DataTemplate>
              </ItemsControl.ItemTemplate>
          </ItemsControl>
          <TextBlock Grid.Row="1" Grid.Column="0" FontWeight="Bold">Description :</TextBlock>
          <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding SelectedMission.Description}"  VerticalAlignment="Top"  TextWrapping="Wrap" />
      </Grid>
  </Grid>
</UserControl>
