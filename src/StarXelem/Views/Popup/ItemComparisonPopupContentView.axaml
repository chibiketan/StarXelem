             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:StarXelem.ViewModels.Popup"
             xmlns:root="clr-namespace:StarXelem"
             xmlns:conv="clr-namespace:StarXelem.Converters"
             xmlns:system="clr-namespace:System;assembly=System.Runtime"
             x:DataType="vm:ItemComparisonPopupContentViewModel"
             d:DataContext="{x:Static root:DesignData.ItemComparisonPopupContentViewModel }"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="StarXelem.Views.Popup.ItemComparisonPopupContentView"
             HorizontalAlignment="Stretch"
             VerticalAlignment="Stretch">
    <UserControl.Resources>
        <conv:StatusToIconConverter x:Key="StatusToIconConverter"/>
        <conv:StatusToVisibilityConverter x:Key="StatusToVisibilityConverter"/>
