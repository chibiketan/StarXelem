<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:StarXelem.ViewModels"
             xmlns:ic="clr-namespace:FluentIcons.Avalonia.Fluent;assembly=FluentIcons.Avalonia.Fluent"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="580"
             x:Class="StarXelem.Views.SettingsTabView"
             x:DataType="vm:SettingsTabViewModel">

    <UserControl.Styles>
        <Style Selector="TextBlock.section-label">
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Foreground" Value="{DynamicResource DimmingBrush}"/>
            <Setter Property="LetterSpacing" Value="0.8"/>
        </Style>

        <Style Selector="TextBlock.action-title">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Foreground" Value="{DynamicResource ForegroundBrush}"/>
        </Style>

        <Style Selector="TextBlock.action-desc">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Foreground" Value="{DynamicResource DimmingBrush}"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="LineHeight" Value="17"/>
        </Style>

        <Style Selector="Button.btn-save">
            <Setter Property="Background" Value="{DynamicResource ButtonPrimaryBackgroundBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource ButtonPrimaryBorderBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource ButtonPrimaryForegroundBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="7"/>
            <Setter Property="Padding" Value="14,7"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="Medium"/>

            <Style Selector="^:pointerover /template/ ContentPresenter">
                <Setter Property="Background" Value="{DynamicResource ButtonPrimaryHoverBackgroundBrush}"/>
            </Style>
        </Style>

        <Style Selector="TextBox.txt-api-key">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>
    </UserControl.Styles>

    <Panel Classes="main">
        <ScrollViewer HorizontalScrollBarVisibility="Disabled" Classes="main">
            <StackPanel Margin="28,24" Spacing="14">

                <!-- En-tête de page -->
                <StackPanel Spacing="2">
                    <TextBlock Text="Paramètres" FontSize="15" FontWeight="Medium"
                               Foreground="{DynamicResource ForegroundBrush}" />
                    <TextBlock Text="Configuration de l'application" FontSize="11"
                               Foreground="{DynamicResource DimmingBrush}" />
                </StackPanel>

                <Separator Classes="horizontal" Background="{DynamicResource CardBorderBrush}" />

                <!-- Section : Clés API -->
                <TextBlock Classes="section-label" Text="CLÉS API" />

                <!-- Carte : Clé API -->
                <Border Background="{DynamicResource CardBackgroundBrush}"
                        BorderBrush="{DynamicResource CardBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="10"
                        Padding="18,16">
                    <Grid ColumnDefinitions="Auto,*,Auto">
                        <Border Grid.Column="0"
                                Width="38" Height="38"
                                CornerRadius="9"
                                Background="{DynamicResource ButtonPrimaryBackgroundBrush}"
                                BorderBrush="{DynamicResource ButtonPrimaryBorderBrush}"
                                BorderThickness="1"
                                VerticalAlignment="Center">
                            <ic:SymbolIcon Symbol="Key"
                                           Foreground="{DynamicResource ButtonPrimaryForegroundBrush}"
                                           FontSize="17"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center" />
                        </Border>

                        <StackPanel Grid.Column="1" Margin="16,0" Spacing="8" VerticalAlignment="Center">
                            <StackPanel Spacing="4">
                                <TextBlock Classes="action-title" Text="Clé API" />
                                <TextBlock Classes="action-desc"
                                           Text="Saisissez votre clé API pour accéder aux services externes." />
                            </StackPanel>
                            <TextBox Name="ApiKeyField" Classes="txt-api-key"
                                     Watermark="Entrez votre clé API…"
                                     Text="{Binding ApiKey}" />
                        </StackPanel>

                        <Button Name="SaveApiKeyButton" Grid.Column="2"
                                Classes="btn-save"
                                Command="{Binding SaveApiKeyCommand}"
                                VerticalAlignment="Center"
                                Margin="0,0,0,16">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <ic:SymbolIcon Symbol="Save" FontSize="11" />
                                <TextBlock Text="Sauvegarder" />
                            </StackPanel>
                        </Button>
                    </Grid>
                </Border>

                <!-- Indicateur de sauvegarde réussie -->
                <Border IsVisible="{Binding Saved}"
                        Background="{DynamicResource CardBackgroundBrush}"
                        BorderBrush="{DynamicResource CardBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="7"
                        Padding="12,8">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <ic:SymbolIcon Symbol="CheckmarkCircle"
                                       Foreground="{DynamicResource ButtonPrimaryForegroundBrush}"
                                       FontSize="14"
                                       VerticalAlignment="Center" />
                        <TextBlock Text="Paramètres sauvegardés avec succès."
                                   FontSize="11"
                                   Foreground="{DynamicResource DimmingBrush}"
                                   VerticalAlignment="Center" />
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>
    </Panel>
</UserControl>
