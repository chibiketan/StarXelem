<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:StarXelem.ViewModels"
             xmlns:comp="clr-namespace:StarXelem.Components"
             mc:Ignorable="d" d:DesignWidth="1100" d:DesignHeight="700"
             x:Class="StarXelem.Views.SettingsTabView"
             x:DataType="vm:SettingsTabViewModel">
    <UserControl.Styles>
        <!-- Titre de page et sous-titre -->
        <Style Selector="TextBlock.page-title">
            <Setter Property="FontSize" Value="30" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource Sx.TextBrush}" />
        </Style>
        <Style Selector="TextBlock.page-subtitle">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Foreground" Value="{DynamicResource Sx.SecondaryBrush}" />
        </Style>

        <!-- Libellé de section -->
        <Style Selector="TextBlock.section-label">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="Medium" />
            <Setter Property="Foreground" Value="{DynamicResource Sx.SecondaryBrush}" />
            <Setter Property="Margin" Value="0,10,0,0" />
        </Style>

        <!-- Carte de paramètre -->
        <Style Selector="comp|NotchedBorder.setting-card">
            <Setter Property="CutSize" Value="18" />
            <Setter Property="Padding" Value="24,20" />
            <Setter Property="Background" Value="{DynamicResource Sx.SurfaceBrush}" />
        </Style>
        <Style Selector="TextBlock.setting-title">
            <Setter Property="FontSize" Value="16" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource Sx.TextBrush}" />
        </Style>
        <Style Selector="TextBlock.setting-desc">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Foreground" Value="{DynamicResource Sx.SecondaryBrush}" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
    </UserControl.Styles>

    <!-- La nouvelle charte n'existe qu'en thème sombre : l'écran reste sombre même si Windows est en thème clair. -->
    <ThemeVariantScope RequestedThemeVariant="Dark">
        <Grid Background="{DynamicResource Sx.BackgroundBrush}" TextElement.FontFamily="{DynamicResource Sx.FontSans}">
            <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                <!-- Contenu étiré jusqu'à 1120 px, aligné à gauche au-delà -->
                <Grid Margin="32,30,32,32">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" MaxWidth="1120" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Spacing="10">
                    <TextBlock Classes="page-title" Text="Paramètres" />
                    <TextBlock Classes="page-subtitle" Text="Configuration de l'application" />

                    <!-- Section : clés API -->
                    <TextBlock Classes="section-label" Text="Clés API" />

                    <comp:NotchedBorder Classes="setting-card">
                        <StackPanel Spacing="12">
                            <StackPanel Spacing="3">
                                <TextBlock Classes="setting-title" Text="Clé API" />
                                <TextBlock Classes="setting-desc" Text="Saisissez votre clé API pour accéder aux services externes." />
                            </StackPanel>

                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                                <comp:NotchedBorder Classes="sx-field" CutSize="11" MinWidth="320">
                                    <TextBox Classes="sx revealPasswordButton"
                                             Height="44"
                                             Padding="14,0"
                                             FontSize="14"
                                             PasswordChar="•"
                                             FontFamily="{DynamicResource Sx.FontMono}"
                                             Watermark="Entrez votre clé API…"
                                             Text="{Binding ApiKey}" />
                                </comp:NotchedBorder>

                                <Button Grid.Column="1" Classes="sx primary" Command="{Binding SaveApiKeyCommand}">Sauvegarder</Button>
                            </Grid>

                            <!-- Confirmation de sauvegarde -->
                            <comp:NotchedBorder Classes="sx-badge success" HorizontalAlignment="Left" IsVisible="{Binding Saved}">
                                <StackPanel Orientation="Horizontal" Spacing="7">
                                    <Ellipse />
                                    <TextBlock Text="Paramètres sauvegardés" />
                                </StackPanel>
                            </comp:NotchedBorder>
                        </StackPanel>
                    </comp:NotchedBorder>
                </StackPanel>
                </Grid>
            </ScrollViewer>
        </Grid>
    </ThemeVariantScope>
</UserControl>
