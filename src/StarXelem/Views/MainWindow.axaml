<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:StarXelem.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:ui="clr-namespace:FluentAvalonia.UI.Controls;assembly=FluentAvalonia"
        xmlns:ic="clr-namespace:FluentIcons.Avalonia.Fluent;assembly=FluentIcons.Avalonia.Fluent"
        xmlns:popup="clr-namespace:StarXelem.Views.Popup"
        xmlns:local="clr-namespace:StarXelem"
        xmlns:conv="clr-namespace:StarXelem.Converters"
        MinWidth="1024"
        MinHeight="768"
        mc:Ignorable="d" d:DesignWidth="1024" d:DesignHeight="768"
        x:Class="StarXelem.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Icon="/Assets/xelem-logo.ico"
        d:DataContext="{x:Static local:DesignData.MainWindowViewModel}"
        Title="StarXelem">
    <Window.Resources>
        <StreamGeometry x:Key="folder_open_regular">M20 9.50195V8.74985C20 7.50721 18.9926 6.49985 17.75 6.49985H12.0247L9.64368 4.51995C9.23959 4.18393 8.73063 3.99997 8.20509 3.99997H4.24957C3.00724 3.99997 2 5.00686 1.99957 6.24919L1.99561 17.7492C1.99518 18.9921 3.00266 20 4.24561 20H4.27196C4.27607 20 4.28019 20 4.28431 20H18.4693C19.2723 20 19.9723 19.4535 20.167 18.6745L21.9169 11.6765C22.1931 10.5719 21.3577 9.50195 20.2192 9.50195H20ZM4.24957 5.49997H8.20509C8.38027 5.49997 8.54993 5.56129 8.68462 5.6733L11.2741 7.82652C11.4088 7.93852 11.5784 7.99985 11.7536 7.99985H17.75C18.1642 7.99985 18.5 8.33563 18.5 8.74985V9.50195H6.42385C5.39136 9.50195 4.49137 10.2047 4.241 11.2064L3.49684 14.1837L3.49957 6.24971C3.49971 5.8356 3.83546 5.49997 4.24957 5.49997ZM5.69623 11.5701C5.77969 11.2362 6.07969 11.002 6.42385 11.002H20.2192C20.3819 11.002 20.5012 11.1548 20.4617 11.3126L18.7119 18.3107C18.684 18.4219 18.584 18.5 18.4693 18.5H4.28431C4.12167 18.5 4.00233 18.3472 4.04177 18.1894L5.69623 11.5701Z</StreamGeometry>
        <conv:P4kStateToBrushConverter x:Key="P4kStateToBrushConverter" />
        <conv:GrpcConnectionStatusToTextConverter x:Key="StatusToTextConverter"/>
    </Window.Resources>
    <Grid ColumnDefinitions="225,50,*" ColumnSpacing="10" RowDefinitions="50,*" Background="{DynamicResource BackgroundGrade1Brush}">
        <ComboBox HorizontalAlignment="Stretch" VerticalAlignment="Center" ItemsSource="{Binding InstalledEnvs^, FallbackValue='Loading...'}" SelectedItem="{Binding SelectedP4kFile}">
            <ComboBox.ItemTemplate>
                <DataTemplate>
                    <TextBlock Text="{Binding DisplayVersion}"></TextBlock>
                </DataTemplate>
            </ComboBox.ItemTemplate>
        </ComboBox>
        <Button Name="openFolderButton" Grid.Row="0" Grid.Column="1" HorizontalAlignment="Stretch" VerticalAlignment="Center" Command="{Binding OpenDataP4kCommand}" CommandParameter="{Binding $parent[Window]}">
            <PathIcon Data="{StaticResource folder_open_regular}" />
        </Button>
        <!-- <Label Grid.Row="0" Grid.Column="2" Content="{Binding P4kStatus}" VerticalAlignment="Center" Margin="25 0 0 0" /> -->
        <ic:SymbolIcon Grid.Row="0" Grid.Column="2" Name="IconP4kStatus" HorizontalAlignment="Left" VerticalAlignment="Center" Symbol="Server"
                       Foreground="{Binding FileLoadState, Converter={StaticResource P4kStateToBrushConverter}}"
                       ToolTip.Tip="{Binding P4kStatusTooltip}" />
        <Grid Grid.Row="0" Grid.Column="2" HorizontalAlignment="Right" ColumnDefinitions="Auto, Auto">
            <Grid.Styles>
                <Style Selector="Border.conn-indicator">
                    <!-- Style pour le tooltip -->
                    <Style Selector="^ ToolTip">
                        <!-- On met la même width que le bouton -->
                        <Setter Property="Width" Value="{Binding $parent[Border].Bounds.Width}" />
                        <Setter Property="ContentTemplate">
                            <DataTemplate DataType="{x:Type x:String}">
                                <Grid RowDefinitions="Auto,Auto">
                                    <TextBlock Grid.Row="0" Classes="bold" Foreground="{DynamicResource ConnErrorTextBrush}" Margin="0 0 0 5">MESSAGE D'ERREUR</TextBlock>
                                    <TextBlock Grid.Row="1" Text="{Binding .}"/>
                                </Grid>
                            </DataTemplate>
                        </Setter>
                    </Style>
                </Style>
            </Grid.Styles>
            
            <!-- Connection Status Indicator -->
            <Border Grid.Column="0" Classes="conn-indicator"
                    Classes.conn-disconnected="{Binding IsDisconnected}"
                    Classes.conn-connecting="{Binding IsConnecting}"
                    Classes.conn-connected="{Binding IsConnected}"
                    Classes.conn-in-game="{Binding IsInGame}"
                    Classes.conn-error="{Binding IsError}"
                    ToolTip.Tip="{Binding GrpcErrorMessage}"
                    ToolTip.Placement="Bottom"
                    HorizontalAlignment="Right" VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal">
                    <Ellipse Classes="conn-dot"/>
                    <TextBlock Classes="conn-text bold" Text="{Binding GrpcStatusDisplay}" Margin="6,0,0,0"/>
                    <TextBlock Classes="shard" Text="{Binding CurrentShardName}" IsVisible="{Binding IsInGame}" Margin="10,0,0,0"/>
                    <TextBlock MaxLines="1" Classes="error-msg" Text="{Binding GrpcErrorMessage}" IsVisible="{Binding IsError}" Margin="10,0,0,0" TextTrimming="CharacterEllipsis" MaxWidth="100"/>
                </StackPanel>
            </Border>
            <!-- Bouton de changement de thème -->
            <Button Classes="btn principal" Name="SwitchTheme" Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center" Command="{Binding SwitchThemeCommand}" Margin="10 0">
                <ic:SymbolIcon Symbol="DarkTheme" />
            </Button>
        </Grid>
        <ui:NavigationView
            Grid.Row="1"
            Grid.ColumnSpan="3"
            Name="NavigationView"
            AlwaysShowHeader="False"
            MenuItemsSource="{Binding Pages}"
            SelectedItem="{Binding CurrentPage}"
            PaneDisplayMode="Left"
            IsBackEnabled="False"
            IsSettingsVisible="False"
            IsPaneToggleButtonVisible="True"
            IsBackButtonVisible="False"
            OpenPaneLength="190">
            <ui:NavigationView.MenuItemTemplate>
                <DataTemplate DataType="vm:PageViewModelBase">
                    <ui:NavigationViewItem
                        
                        Content="{Binding Name}"
                        IconSource="{Binding Icon}" />
                </DataTemplate>
            </ui:NavigationView.MenuItemTemplate>
            <ContentControl Content="{Binding CurrentPage}" />
        </ui:NavigationView>
        <popup:MainPopup Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="3" DataContext="{Binding PopupViewModel}" />
    </Grid>


</Window>
