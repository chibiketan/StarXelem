<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
        Icônes d'équipement StarXelem
        Usage dans un contrôle :
            <Path Data="{StaticResource Icon.Helmet}"
                  Stretch="Uniform"
                  Width="20" Height="20"
                  Fill="{DynamicResource MyBrush}" />

        À inclure dans App.axaml :
            <Application.Resources>
                <ResourceDictionary>
                    <ResourceDictionary.MergedDictionaries>
                        <ResourceInclude Source="/Assets/equipment_icons.axaml"/>
                    </ResourceDictionary.MergedDictionaries>
                </ResourceDictionary>
            </Application.Resources>
    -->

    <!-- ═══════════════════════════════════════════
         ARMURE
    ═══════════════════════════════════════════ -->

    <!-- Casque
         Forme : calotte avec oreillettes latérales et visière centrale -->
    <StreamGeometry x:Key="Icon.Helmet">
        M 19 5
        C 12 5 8 10 8 16
        L 8 21
        C 8 22.1 8.9 23 10 23
        L 10 24
        C 10 25.1 10.9 26 12 26
        L 26 26
        C 27.1 26 28 25.1 28 24
        L 28 23
        C 29.1 23 30 22.1 30 21
        L 30 16
        C 30 10 26 5 19 5 Z
        M 12 26 L 12 29
        C 12 30.1 12.9 31 14 31
        L 24 31
        C 25.1 31 26 30.1 26 29
        L 26 26
        M 8 18
        C 6.5 18 5.5 19 5.5 20.5
        C 5.5 22 6.5 23 8 23
        M 30 18
        C 31.5 18 32.5 19 32.5 20.5
        C 32.5 22 31.5 23 30 23
        M 13 17 L 25 17 L 25 23 L 13 23 Z
    </StreamGeometry>

    <!-- Corps
         Forme : plastron avec épaulières intégrées et lanières latérales -->
    <StreamGeometry x:Key="Icon.Body">
        M 12 5 L 26 5 L 29 10 L 29 26
        C 29 27.1 28.1 28 27 28
        L 11 28
        C 9.9 28 9 27.1 9 26
        L 9 10 Z
        M 12 5 L 9 10 L 9 14 L 5 14 L 5 22 L 9 22
        M 26 5 L 29 10 L 29 14 L 33 14 L 33 22 L 29 22
        M 5 14 L 9 14
        M 5 22 L 9 22
        M 29 14 L 33 14
        M 29 22 L 33 22
    </StreamGeometry>

    <!-- Bras
         Forme : paire de brassards vus de face avec coudières -->
    <StreamGeometry x:Key="Icon.Arms">
        M 11 5 L 17 5 L 17 8 L 20 8 L 20 30 L 14 30 L 14 28 L 11 28 Z
        M 21 5 L 27 5 L 27 28 L 24 28 L 24 30 L 18 30 L 18 8 L 21 8 Z
        M 11 18 L 17 18 L 17 23 L 11 23 Z
        M 21 18 L 27 18 L 27 23 L 21 23 Z
        M 14 28 L 14 32
        M 24 28 L 24 32
        M 12 32 L 16 32
        M 22 32 L 26 32
    </StreamGeometry>

    <!-- Jambes
         Forme : paire de jambières vues de face avec genouillères -->
    <StreamGeometry x:Key="Icon.Legs">
        M 12 4 L 18 4 L 18 20 L 16 28 L 16 33 L 12 33 L 12 28 L 10 20 Z
        M 20 4 L 26 4 L 28 20 L 26 28 L 26 33 L 22 33 L 22 28 L 20 20 Z
        M 10 11 L 18 11 L 18 16 L 10 16 Z
        M 20 11 L 28 11 L 28 16 L 20 16 Z
        M 10 33 L 17 33
        M 21 33 L 28 33
    </StreamGeometry>

    <!-- ═══════════════════════════════════════════
         ARME
    ═══════════════════════════════════════════ -->

    <!-- Arme lourde
         Forme : fusil à canon épais, crosse large et garde-main -->
    <StreamGeometry x:Key="Icon.HeavyWeapon">
        M 4 16 L 26 16 L 26 23 L 4 23 Z
        M 26 17.5 L 34 17.5 L 34 21.5 L 26 21.5 Z
        M 10 16 L 10 13 L 20 13 L 20 16
        M 6 23 L 6 28 L 16 28 L 16 23
        M 10 19.5 A 1.5 1.5 0 1 1 10.01 19.5
        M 20 19.5 L 24 19.5
    </StreamGeometry>

    <!-- Arme légère
         Forme : fusil d'assaut profilé avec chargeur sous le corps et canon fin -->
    <StreamGeometry x:Key="Icon.LightWeapon">
        M 7 17 L 28 17 L 28 23 L 7 23 Z
        M 28 19 L 30 18 L 33 18.5 L 33 21.5 L 30 22 L 28 21
        M 10 23 L 10 29 L 20 29 L 20 23
        M 13 20 A 1.2 1.2 0 1 1 13.01 20
    </StreamGeometry>

    <!-- Pistolet
         Forme : pistolet compact avec crosse vers le bas et canon court -->
    <StreamGeometry x:Key="Icon.Pistol">
        M 8 15 L 26 15 L 26 22 L 8 22 Z
        M 26 18 L 29 18 L 31 17.5 L 31 19.5 L 29 19 L 28 22
        M 8 15 L 8 13 L 16 13 L 16 15
        M 10 21 L 8 21 L 8 31
        C 8 32.1 8.9 33 10 33
        L 14 33
        C 15.1 33 16 32.1 16 31
        L 16 22
        M 12 18 A 1.2 1.2 0 1 1 12.01 18
        M 8 31 L 16 31
    </StreamGeometry>

    <!-- ═══════════════════════════════════════════
         MUNITION
    ═══════════════════════════════════════════ -->

    <!-- Munition
         Forme : cartouche vue de face avec ogive et douille -->
    <StreamGeometry x:Key="Icon.Ammunition">
        M 14 10
        C 14 7 16 6 19 6
        C 22 6 24 7 24 10
        L 24 26 L 14 26 Z
        M 13 26 L 25 26 L 25 33 L 13 33 Z
        M 16 26 L 16 33
        M 19 26 L 19 33
        M 22 26 L 22 33
        M 16 14 L 22 14
        M 16 18 L 22 18
        M 16 22 L 22 22
    </StreamGeometry>

</ResourceDictionary>
